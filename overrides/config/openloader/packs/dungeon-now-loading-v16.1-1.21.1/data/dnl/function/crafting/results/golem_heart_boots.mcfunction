### Required crafting materials ###
execute if entity @s[nbt={Item:{id:"minecraft:iron_ingot"}}] at @s positioned ~ ~1.5 ~ as @e[type=minecraft:item_frame,tag=dnl.material,tag=!dnl.material.used,tag=dnl.iron_ingot,distance=..2.1,sort=random,limit=1] at @s run function dnl:crafting/material_used
execute if entity @s[nbt={Item:{id:"minecraft:iron_block"}}] at @s positioned ~ ~1.5 ~ as @e[type=minecraft:item_frame,tag=dnl.material,tag=!dnl.material.used,tag=dnl.iron_block,distance=..2.1,sort=random,limit=1] at @s run function dnl:crafting/material_used
execute if entity @s[nbt={Item:{id:"minecraft:vine"}}] at @s positioned ~ ~1.5 ~ as @e[type=minecraft:item_frame,tag=dnl.material,tag=!dnl.material.used,tag=dnl.vine,distance=..2.1,sort=random,limit=1] at @s run function dnl:crafting/material_used
execute if entity @s[nbt={Item:{id:"minecraft:poppy",components:{"minecraft:custom_data":{"dnl.poppy_of_flanders":1b}}}}] at @s positioned ~ ~1.5 ~ as @e[type=minecraft:item_frame,tag=dnl.material,tag=!dnl.material.used,tag=dnl.poppy_of_flanders,distance=..2.1,sort=random,limit=1] at @s run function dnl:crafting/material_used


### Reset Crafter ###
execute if score @s dnl.success matches 1.. run function dnl:crafting/success

### Crafted item ###
execute if score @s dnl.craftpoint matches 6.. at @s positioned ~ ~1.5 ~ if entity @e[type=minecraft:item_frame,tag=dnl.material,tag=dnl.iron_ingot,tag=dnl.material.used,distance=..2.1] if entity @e[type=minecraft:item_frame,tag=dnl.material,tag=dnl.iron_block,tag=dnl.material.used,distance=..2.1] if entity @e[type=minecraft:item_frame,tag=dnl.material,tag=dnl.vine,tag=dnl.material.used,distance=..2.1] if entity @e[type=minecraft:item_frame,tag=dnl.material,tag=dnl.poppy_of_flanders,tag=dnl.material.used,distance=..2.1] run loot spawn ~ ~ ~ loot dnl:items/golem_heart_boots
### Crafting Success ###
execute if score @s dnl.craftpoint matches 6.. at @s positioned ~ ~1.5 ~ if entity @e[type=minecraft:item_frame,tag=dnl.material,tag=dnl.iron_ingot,tag=dnl.material.used,distance=..2.1] if entity @e[type=minecraft:item_frame,tag=dnl.material,tag=dnl.iron_block,tag=dnl.material.used,distance=..2.1] if entity @e[type=minecraft:item_frame,tag=dnl.material,tag=dnl.vine,tag=dnl.material.used,distance=..2.1] if entity @e[type=minecraft:item_frame,tag=dnl.material,tag=dnl.poppy_of_flanders,tag=dnl.material.used,distance=..2.1] run playsound minecraft:entity.experience_orb.pickup block @a[distance=..6] ~ ~ ~ 1 1 1
execute if score @s dnl.craftpoint matches 6.. at @s positioned ~ ~1.5 ~ if entity @e[type=minecraft:item_frame,tag=dnl.material,tag=dnl.iron_ingot,tag=dnl.material.used,distance=..2.1] if entity @e[type=minecraft:item_frame,tag=dnl.material,tag=dnl.iron_block,tag=dnl.material.used,distance=..2.1] if entity @e[type=minecraft:item_frame,tag=dnl.material,tag=dnl.vine,tag=dnl.material.used,distance=..2.1] if entity @e[type=minecraft:item_frame,tag=dnl.material,tag=dnl.poppy_of_flanders,tag=dnl.material.used,distance=..2.1] run function dnl:crafting/reset_result
