	quest.A2E0CA9576DCA77A.title: "末影傀儡"
	quest.A2EEB454D134955A.quest_desc: [
		"远古残骸生成在 Y=8-22。"
		"4 残骸 + 4 金锭 = 1 下界合金碎片。"
		"4 碎片 + 4 金锭 = 1 下界合金锭。"
		"用锻造台升级钻石装备！"
	]
