	quest.00596BA4ED087A90.quest_desc: [
		"观测者（The Watcher）以目光为武器。"
		"它注视的区域会爆发伤害。"
		"时刻注意它的朝向！"
	]
	quest.00596BA4ED087A90.quest_subtitle: "注视一切"
	quest.00596BA4ED087A90.title: "观测者"
	quest.00A78BD1F10BE5D5.quest_desc: ["{chapter.12.quest.4.description.1}"]
	quest.02AEC569D0486F89.quest_desc: ["{chapter.12.quest.40.description.1}"]
	quest.02E6CAED08671CD3.quest_desc: [
		"光谱（Spectrum）是一套深度魔法系统。"
		"先获得光谱指南书，它会指导你。"
		"任务书中的光谱章节（原有）会逐步引导。"
	]
	quest.02E6CAED08671CD3.quest_subtitle: "魔法的开始"
	quest.02E6CAED08671CD3.title: "光谱指南"
	quest.036AE68A182F07A6.quest_desc: [
		"用灾厄材料合成 Ignitium 系列装备。"
		"灾厄装备属性强大，是后期核心。"
		"升级锻造模板可进一步提升。"
		"灾厄武器附带独特效果。"
	]
	quest.036AE68A182F07A6.quest_subtitle: "变强的阶梯"
	quest.036AE68A182F07A6.title: "灾厄装备"
	quest.03B86DF7F13FFE73.quest_desc: [
		"本包用 KubeJS 添加/修改了大量配方。"
		"在 EMI 中查看所有配方（E 键）。"
		"注意：部分配方有特殊条件。"
	]
	quest.03B86DF7F13FFE73.quest_subtitle: "定制合成"
	quest.03B86DF7F13FFE73.title: "KubeJS 配方"
	quest.04BF6A22E80AA0A1.quest_desc: [
		"暮初恶魂是暮色的最终 Boss，漂浮在暗黑高塔之上。"
		"它召唤火球与爪牙，血量极高。"
		"准备充足的弓弩！"
	]
	quest.04BF6A22E80AA0A1.quest_subtitle: "暮初恶魂"
	quest.04BF6A22E80AA0A1.title: "暗黑高塔"
	quest.04D42F8AC2ACAF12.quest_desc: [
		"木桶比箱子更紧凑（可贴墙）。"
		"Sophisticated Storage 模组提供升级型存储。"
		"配合物品整理快捷键高效管理。"
	]
	quest.04D42F8AC2ACAF12.quest_subtitle: "整理物资"
	quest.04D42F8AC2ACAF12.title: "存储扩展"
	quest.051A4AD9A44AAD7C.quest_desc: [
		"击败末影龙，完成原版的主线目标之一。"
		"末影龙也是进化之剑的成长记录之一。"
		"战后可探索末地城获取鞘翅。"
	]
	quest.051A4AD9A44AAD7C.quest_subtitle: "终焉之战"
	quest.051A4AD9A44AAD7C.title: "末影龙讨伐"
	quest.05356A9854E67806.quest_desc: ["陨落圣殿（Sanctum Fallen）是神秘遗迹维度。"]
	quest.05356A9854E67806.quest_subtitle: "神秘维度"
	quest.05356A9854E67806.title: "陨落圣殿"
	quest.0551B892DEBBFE73.quest_desc: [
		"用 12 颗钻石扔进水中可开启暮色传送门。"
		"暮色森林有娜迦、巫妖、九头蛇等众多 Boss。"
		"完成 Boss 挑战可获得强力装备。"
	]
	quest.0551B892DEBBFE73.quest_subtitle: "童话中的冒险"
	quest.0551B892DEBBFE73.title: "暮色森林"
	quest.0644644B29DC26DB.quest_desc: [
		"暮初恶魂是暗黑高塔的最终 Boss，漂浮在塔顶。"
		"它召唤火球与爪牙，血量极高。"
		"推荐：准备充足的弓弩与治疗。"
	]
	quest.0644644B29DC26DB.quest_subtitle: "高塔之上"
	quest.0644644B29DC26DB.title: "暮初恶魂"
	quest.06B89C0B48780A85.quest_desc: ["{chapter.12.quest.69.description.1}"]
	quest.06B89C0B48780A85.quest_subtitle: "{chapter.12.quest.69.subtitle}"
	quest.06F247E00A3D4F27.quest_desc: [
		"暮初恶魂是暮色最终 Boss。"
		"它漂浮在暗黑高塔上空，召唤火球与爪牙。"
		"血量极高——准备大量弓弩弹药。"
		"击败后暮色主线完成！"
	]
	quest.06F247E00A3D4F27.quest_subtitle: "暮初恶魂"
	quest.06F247E00A3D4F27.title: "暗黑高塔"
	quest.07E865C19F2BE25F.quest_desc: [
		"Comforts 提供睡袋与吊床，可在户外睡觉。"
		"旅行途中不再需要担心夜晚。"
	]
	quest.07E865C19F2BE25F.quest_subtitle: "旅人的休憩"
	quest.07E865C19F2BE25F.title: "露营装备"
	quest.098B8BA9BACAFC0D.quest_desc: [
		"远古遗魂（Ancient Remnant）是灾厄的古老 Boss。"
		"它掌握远古之力，攻击多样。"
	]
	quest.098B8BA9BACAFC0D.quest_subtitle: "古老的存在"
	quest.098B8BA9BACAFC0D.title: "远古遗魂"
	quest.09E84A78CBC3A9B4.quest_desc: [
		"咒翼灵骸（Maledictus）挥舞诅咒之翼。"
		"灵魂系攻击难以格挡。"
		"注意灵魂弹幕的轨迹。"
	]
	quest.09E84A78CBC3A9B4.quest_subtitle: "诅咒之翼"
	quest.09E84A78CBC3A9B4.title: "咒翼灵骸"
	quest.0A32770CB61EB13B.quest_desc: [
		"锻造厂是灾厄的锻造主题维度。"
		"在这里可以挑战强大的锻炉守护者。"
	]
	quest.0A32770CB61EB13B.quest_subtitle: "Forge of Aeons"
	quest.0A32770CB61EB13B.title: "灾厄·锻造厂"
	quest.0AF3AE7F010C0237.quest_desc: [
		"任务完成提示音效。"
		"佩戴后不错过任何完成。"
	]
	quest.0AF3AE7F010C0237.quest_subtitle: "提示饰品"
	quest.0AF3AE7F010C0237.title: "哔哔机"
	quest.0B0A492803DA084D.quest_desc: [
		"Rotten Creatures 添加腐烂生物（沼泽、冰雪、海洋变种）。"
		"Graveyard 添加墓园与复活的亡灵。"
		"夜晚的世界更加热闹。"
		"它们都有独特掉落。"
	]
	quest.0B0A492803DA084D.quest_subtitle: "丧尸与骷髅"
	quest.0B0A492803DA084D.title: "亡灵生态"
	quest.0BC3BEA171B52A6F.quest_desc: [
		"整合包还有更多内容等你发掘："
		"烹饪模组（万花筒厨艺）、更多下界生物、环境音效、天气系统等。"
		"打开 JEI（E 键附近）查看所有配方！"
	]
	quest.0BC3BEA171B52A6F.quest_subtitle: "更多内容"
	quest.0BC3BEA171B52A6F.title: "探索其他"
	quest.0BCBC476BE6FA8B2.quest_desc: ["{chapter.12.quest.51.description.1}"]
	quest.0C1A11FC3741DB27.quest_desc: [
		"末影守卫（Ender Guardian）守护灾厄的末影区域。"
		"近战与投射兼备。"
		"建议格挡与闪避结合。"
	]
	quest.0C1A11FC3741DB27.quest_subtitle: "末影守护"
	quest.0C1A11FC3741DB27.title: "末影守卫"
	quest.0C4D54711D5DA01A.quest_desc: [
		"Artifacts 模组为探索添加神器饰品。"
		"无尽的牛肉、熔岩之靴等神器散落在遗迹中。"
		"装备在 Curios 栏位获得独特效果。"
	]
	quest.0C4D54711D5DA01A.quest_subtitle: "探索战利品"
	quest.0C4D54711D5DA01A.title: "神器饰品 Artifacts"
	quest.0E4B5A4A81630D9D.quest_desc: [
		"熔岩之靴免疫火焰伤害。"
		"下界探险神器。"
		"从下界遗迹宝箱获得。"
	]
	quest.0E4B5A4A81630D9D.quest_subtitle: "踏火而行"
	quest.0E4B5A4A81630D9D.title: "熔岩之靴"
	quest.0F39D234B9AE6FBF.quest_desc: [
		"娜迦鳞片合成娜迦鳞甲。"
		"鳞甲是暮色中期防具。"
		"完成整套获得套装效果。"
	]
	quest.0F39D234B9AE6FBF.quest_subtitle: "鳞甲材料"
	quest.0F39D234B9AE6FBF.title: "娜迦鳞片"
	quest.0F5773559E05C414.quest_desc: ["{chapter.12.quest.26.description.1}"]
	quest.0F5773559E05C414.quest_subtitle: "会有蓝色的特效与声音"
	quest.0F5E37F2E0D41F0D.quest_desc: [
		"主世界是冒险的起点。"
		"探索地形、寻找村庄、发展农业与矿物。"
		"夜晚小心怪物，做好防御。"
	]
	quest.0F5E37F2E0D41F0D.quest_subtitle: "你的起点"
	quest.0F5E37F2E0D41F0D.title: "主世界"
	quest.10A51CAEF127EBB8.quest_desc: [
		"选择模块需要花费一点心得点,当一个模块点满之后可以解锁一个顿悟槽"
		"顿悟有些有解锁条件,目前暂时不能重置"
	]
	quest.10A51CAEF127EBB8.title: "心得与顿悟"
	quest.1114AFE44AA5C9AF.quest_desc: [
		"岩浆怪掉落岩浆膏。"
		"酿造抗火药水必备。"
		"下界与下界要塞常见。"
	]
	quest.1114AFE44AA5C9AF.quest_subtitle: "史莱姆与酿造"
	quest.1114AFE44AA5C9AF.title: "岩浆膏"
	quest.116BF87094EA4E42.quest_desc: ["{chapter.12.quest.22.description.1}"]
	quest.11A11F5125227C37.quest_desc: [
		"3 羊毛 + 3 木板合成床。"
		"夜晚睡觉跳过黑夜并设置重生点。"
		"找不到羊毛就找羊！"
	]
	quest.11A11F5125227C37.quest_subtitle: "安睡与重生"
	quest.11A11F5125227C37.title: "床"
	quest.11C9DDC24829264A.quest_desc: [
		"骑士金属来自幻影骑士。"
		"合成骑士金属装备。"
		"也可用于其他合成。"
	]
	quest.11C9DDC24829264A.quest_subtitle: "进阶材料"
	quest.11C9DDC24829264A.title: "骑士金属"
	quest.12120F20E3E5F5AD.quest_desc: [
		"本任务书由 FTB Quests 提供。"
		"任务之间可能存在前置依赖，完成前置才能解锁后续任务。"
		"完成任务可获得奖励，奖励会自动发放到背包。"
	]
	quest.12120F20E3E5F5AD.quest_subtitle: "FTB 任务说明"
	quest.12120F20E3E5F5AD.title: "认识任务系统"
	quest.1260255A7D43E8E4.quest_desc: [
		"欢迎来到 if-1.3 整合包！"
		"这个整合包包含神秘、暮色森林、灾变等众多模组，以及大量 KubeJS 定制内容。"
		"打开任务书（默认按键 Q 或按章节图标）跟随指引，一步步变强吧！"
	]
	quest.1260255A7D43E8E4.quest_subtitle: "开始你的冒险"
	quest.1260255A7D43E8E4.title: "欢迎来到 if-1.3"
	quest.12766F7759AA7EE6.quest_desc: [""]
	quest.12766F7759AA7EE6.quest_subtitle: "{chapter.12.quest.13.subtitle}"
	quest.12A3A0E72B79AE96.quest_desc: [
		"下界合金构成，防御极高。"
		"灾厄终局 Boss 之一。"
	]
	quest.12A3A0E72B79AE96.quest_subtitle: "金属怪物"
	quest.12A3A0E72B79AE96.title: "下界合金巨兽"
	quest.12B400C752DF166B.quest_desc: [
		"Twilight Souls 为暮色 Boss 添加灵魂材料。"
		"击败暮色 Boss 收集灵魂，合成强力物品。"
	]
	quest.12B400C752DF166B.quest_subtitle: "灵魂的力量"
	quest.12B400C752DF166B.title: "暮色之魂"
	quest.141C7F400CC683B5.quest_desc: [
		"整合包中还有更多 Boss 等待挑战："
		"mowziesmobs 的钢铁守护者、霜冻巨兽、雕刻家、太阳鸟；"
		"dungeonnowloading 的公正衔环·波罗斯与乌洛斯等。"
		"击败它们同样计入进化之剑的成长记录！"
	]
	quest.141C7F400CC683B5.quest_subtitle: "更多挑战"
	quest.141C7F400CC683B5.title: "其他 Boss"
	quest.152C94B2BEB2F234.quest_desc: [
		"远古遗魂（Ancient Remnant）掌握远古之力。"
		"多种元素攻击交替。"
		"熟悉节奏后逐个躲避。"
	]
	quest.152C94B2BEB2F234.quest_subtitle: "古老存在"
	quest.152C94B2BEB2F234.title: "远古遗魂"
	quest.16F2AA5B627A73D7.quest_desc: ["瞬移与范围伤害。"]
	quest.16F2AA5B627A73D7.quest_subtitle: "末影造物"
	quest.16F2AA5B627A73D7.title: "末影傀儡"
	quest.1728BDC9041B7147.quest_desc: [
		"模块分主题：攻击、生存、潜匿、召唤、防御、探索、采矿、牺牲、研习等。"
		"点亮心得获得永久属性加成。"
		"布局规则：先点亮前置心得。"
		"选择适合你玩法的模块优先。"
	]
	quest.1728BDC9041B7147.quest_subtitle: "永久加成"
	quest.1728BDC9041B7147.title: "模块与心得"
	quest.17CD0A3691B796CE.quest_desc: [
		"灾厄（L_Ender's Cataclysm）是后期高难模组。"
		"它包含 8 个独立维度与 10+ 个强力 Boss。"
		"建议先完成暮色森林与光谱基础再来挑战！"
	]
	quest.17CD0A3691B796CE.quest_subtitle: "高难挑战"
	quest.17CD0A3691B796CE.title: "灾厄简介"
	quest.17F4708EA2DA3077.quest_desc: [
		"Field Guide 图鉴记录你发现的世界："
		"击杀/扫描新生物解锁图鉴条目。"
		"每解锁一个新图鉴获得 2 阅历！"
		"图鉴总数达到 10 时攻击伤害 +1。"
	]
	quest.17F4708EA2DA3077.quest_subtitle: "探索与收集"
	quest.17F4708EA2DA3077.title: "Field Guide 图鉴"
	quest.18428EA815D7B567.quest_desc: [
		"深入地下寻找钻石（Y=-59 附近最密集）。"
		"钻石是高级装备与暮色传送门的材料。"
	]
	quest.18428EA815D7B567.quest_subtitle: "珍贵矿物"
	quest.18428EA815D7B567.title: "钻石勘探"
	quest.18DF456E1A56DCD1.quest_desc: ["{chapter.12.quest.49.description.1}"]
	quest.18DF456E1A56DCD1.quest_subtitle: "{chapter.12.quest.49.subtitle}"
	quest.18DF456E1A56DCD1.title: "{chapter.12.quest.49.title}"
	quest.1948F098E2BA2B6E.quest_desc: [
		"按 K 打开顿悟界面。"
		"完成模块获得心得点与顿悟槽位。"
		"点亮心得得永久加成，激活顿悟得强大能力。"
		"阅历升级心得点（每 10 阅历 +1 心得点）。"
	]
	quest.1948F098E2BA2B6E.quest_subtitle: "成长核心"
	quest.1948F098E2BA2B6E.title: "顿悟系统 Epiphany"
	quest.196161A9CF8169B1.quest_desc: [
		"下界由地狱岩构成，遍布岩浆。"
		"注意恶魂、猪灵、烈焰人。"
		"金制装备可避免猪灵攻击。"
	]
	quest.196161A9CF8169B1.quest_subtitle: "红黑的世界"
	quest.196161A9CF8169B1.title: "下界地貌"
	quest.199BDB49DFDF0EC9.quest_desc: [
		"冰雪女王镇守极光宫殿。"
		"她会召唤冰晶守卫并发射冰刺。"
		"击败后获得冰霜权杖等奖励。"
	]
	quest.199BDB49DFDF0EC9.quest_subtitle: "冰川宫殿"
	quest.199BDB49DFDF0EC9.title: "冰雪女王"
	quest.1AEF781EE1C71C31.quest_desc: [
		"阅历可以从多种行为获得："
		"击杀 Boss（+心得点）、首次进维度、首次吃新食物、解锁新图鉴（+2）。"
		"多多探索，阅历滚滚而来！"
	]
	quest.1AEF781EE1C71C31.quest_subtitle: "如何升级"
	quest.1AEF781EE1C71C31.title: "阅历获取方式"
	quest.1BCBA10BC193FAAF.quest_desc: [
		"下界合金巨兽（Netherite Monstrosity）是灾厄的终局 Boss 之一。"
		"全身由下界合金构成，防御极高。"
	]
	quest.1BCBA10BC193FAAF.quest_subtitle: "金属的怪物"
	quest.1BCBA10BC193FAAF.title: "下界合金巨兽"
	quest.1CDC2A8C45E4CEBA.quest_desc: [
		"远古之力，多元素攻击。"
		"熟悉节奏逐个躲避。"
	]
	quest.1CDC2A8C45E4CEBA.quest_subtitle: "古老存在"
	quest.1CDC2A8C45E4CEBA.title: "远古遗魂"
	quest.1D26B4EA81538C0A.quest_desc: ["{chapter.12.quest.5.description.1}"]
	quest.1D26B4EA81538C0A.quest_subtitle: "{chapter.12.quest.5.subtitle}"
	quest.1D26B4EA81538C0A.title: "{chapter.12.quest.5.title}"
	quest.1E114E9019D2C90E.quest_desc: ["{chapter.12.quest.23.description.1}"]
	quest.1EA74B8A4FBAA239.quest_desc: [
		"击败末影龙是原版的最终目标之一。"
		"准备足够的弓箭、金苹果与附魔装备。"
		"击败末影龙后可前往末地城获得鞘翅。"
	]
	quest.1EA74B8A4FBAA239.quest_subtitle: "终焉之地"
	quest.1EA74B8A4FBAA239.title: "末地"
	quest.1F4D8896C043EE72.quest_desc: [
		"图鉴总数达到 10：攻击伤害 +1。"
		"图鉴也是了解整合包生物的好帮手。"
		"努力集齐吧！"
	]
	quest.1F4D8896C043EE72.quest_subtitle: "收集目标"
	quest.1F4D8896C043EE72.title: "图鉴成就"
	quest.209AEE075F1D0C49.quest_desc: [
		"进化之剑是一把会成长的武器：每击杀过一个 Boss，攻击伤害 +5。"
		"手持时属性面板可见加成，Shift 查看已击杀 Boss 列表。"
		"获得方式：顿悟「剑之进化」或任务奖励。"
	]
	quest.209AEE075F1D0C49.quest_subtitle: "会成长的武器"
	quest.209AEE075F1D0C49.title: "进化之剑"
	quest.20A6E081D6A47E98.quest_desc: ["{chapter.12.quest.59.description.1}"]
	quest.20A6E081D6A47E98.quest_subtitle: "{chapter.12.quest.59.subtitle}"
	quest.21599E3E9C8FE21D.quest_desc: [
		"僵尸掉落胡萝卜/马铃薯，村庄也有。"
		"多种作物让饮食多样化，饱食更高。"
	]
	quest.21599E3E9C8FE21D.quest_subtitle: "胡萝卜与马铃薯"
	quest.21599E3E9C8FE21D.title: "多样作物"
	quest.2186D0F99F7C9E21.quest_desc: [
		"下界合金是当前版本最强基础材料。"
		"升级全套装备：工具+护甲。"
		"下界合金装备不会被岩浆烧毁。"
	]
	quest.2186D0F99F7C9E21.quest_subtitle: "顶级材料"
	quest.2186D0F99F7C9E21.title: "下界合金锭"
	quest.21A278F64F7FD633.quest_desc: [
		"8 个圆石合成熔炉。"
		"熔炉烧炼矿物（矿石→锭）和烹饪食物。"
		"燃料：木板、煤炭、熔岩桶等。"
	]
	quest.21A278F64F7FD633.quest_subtitle: "冶炼与烹饪"
	quest.21A278F64F7FD633.title: "熔炉"
	quest.222C4ADE306F53DF.quest_desc: [
		"一切从工作台开始。"
		"砍树获得原木，合成工作台，然后开始你的生存之旅。"
	]
	quest.222C4ADE306F53DF.quest_subtitle: "第一步"
	quest.222C4ADE306F53DF.title: "制作工作台"
	quest.22360EF6CFC10023.quest_desc: [
		"巫妖塔矗立在暗黑森林。"
		"巫妖会瞬移、召唤仆从、释放法术。"
		"击败后获得巫师权杖。"
	]
	quest.22360EF6CFC10023.quest_subtitle: "魔法对决"
	quest.22360EF6CFC10023.title: "巫妖塔"
	quest.238C937E4DF8D960.quest_desc: [
		"整合包包含多个维度："
		"主世界/下界/末地 + 暮色森林 + 灾厄 8 维。"
		"每个维度都有独特的资源与 Boss。"
		"详见「维度指引」章节。"
	]
	quest.238C937E4DF8D960.quest_subtitle: "广阔的世界"
	quest.238C937E4DF8D960.title: "维度探索"
	quest.2457188B993DFC33.quest_desc: ["强大的近战与投射攻击。"]
	quest.2457188B993DFC33.quest_subtitle: "末影守护"
	quest.2457188B993DFC33.title: "末影守卫"
	quest.248525855A8CE23B.quest_desc: [
		"米诺菇隐藏在迷宫花园深处。"
		"它像牛一样冲撞，威力巨大。"
		"迷宫内注意岔路与宝箱。"
	]
	quest.248525855A8CE23B.quest_subtitle: "蘑菇迷宫之主"
	quest.248525855A8CE23B.title: "米诺菇"
	quest.24CC5CBAFC6DB119.quest_desc: ["用于解锁背包内容,拿起对着背包中的锁右键即可解锁"]
	quest.25F6F8B72A56AD84.quest_desc: [
		"哔哔机是一件 Curios 饰品。"
		"完成各种任务时会发出提示音效。"
		"装备后不错过任何成就。"
	]
	quest.25F6F8B72A56AD84.quest_subtitle: "任务提示"
	quest.25F6F8B72A56AD84.title: "哔哔机"
	quest.2646F4AE06A6AD56.quest_desc: ["{chapter.12.quest.67.description.1}"]
	quest.2646F4AE06A6AD56.quest_subtitle: "{chapter.12.quest.67.subtitle}"
	quest.2667A40844853040.quest_desc: [
		"制作地图记录已探索区域。"
		"8 张纸 + 指南针合成空地图。"
		"探索时随身携带。"
	]
	quest.2667A40844853040.quest_subtitle: "记录世界"
	quest.2667A40844853040.title: "制图师之路"
	quest.26A1C2632410801B.quest_desc: [
		"Modonomicon 提供各模组的指南书。"
		"在创造模式搜索或从模组获取。"
		"看不懂模组？先读书！"
	]
	quest.26A1C2632410801B.quest_subtitle: "学习手册"
	quest.26A1C2632410801B.title: "指南书 Modonomicon"
	quest.271877E8E7393D05.quest_desc: ["{chapter.12.quest.1.description.1}"]
	quest.271877E8E7393D05.quest_subtitle: "{chapter.12.quest.1.subtitle}"
	quest.2736671C13390278.quest_desc: [
		"失落堡垒（Bastion Lost）是灾厄的最终挑战区域。"
		"最强的守护者在此盘踞。"
		"进入前确保：全套最强装备、充足补给、进化之剑加成。"
	]
	quest.2736671C13390278.quest_subtitle: "最终领域"
	quest.2736671C13390278.title: "失落堡垒"
	quest.275A0F585FBD2541.quest_desc: ["{chapter.12.quest.44.description.1}"]
	quest.275A0F585FBD2541.quest_subtitle: "需要先解锁午夜残片"
	quest.2790966C917FC37F.quest_desc: [
		"炽热锭来自炽热血池/恶魂战利品。"
		"合成炽热套装——暮色最强防具。"
		"火焰抗性极佳。"
	]
	quest.2790966C917FC37F.quest_subtitle: "暮色顶级材料"
	quest.2790966C917FC37F.title: "炽热锭"
	quest.288285DBDAB1C5FD.quest_desc: ["{chapter.12.quest.7.description.1}"]
	quest.288285DBDAB1C5FD.quest_subtitle: "{chapter.12.quest.7.subtitle}"
	quest.289C10B2FFA438A6.quest_desc: [
		"本任务书由 FTB Quests 提供。"
		"每个章节都有明确的目标与指引。"
		"完成任务的奖励会自动发放。"
	]
	quest.289C10B2FFA438A6.quest_subtitle: "指引与奖励"
	quest.289C10B2FFA438A6.title: "FTB 任务系统"
	quest.29F2ED7A74C38F97.quest_desc: [
		"Graveyard 模组添加亡灵主题内容。"
		"探索墓园，面对复活的骷髅。"
		"击败它们获得骨制武器与材料。"
	]
	quest.29F2ED7A74C38F97.quest_subtitle: "死者的低语"
	quest.29F2ED7A74C38F97.title: "墓园 Graveyard"
	quest.2A139B079AFC90B6.quest_desc: [
		"深渊（Abyssal Depths）是灾厄第一个维度。"
		"通过灾厄的传送方式进入。"
		"这里的怪物明显更强。"
	]
	quest.2A139B079AFC90B6.quest_subtitle: "Cataclysm 起点"
	quest.2A139B079AFC90B6.title: "深渊"
	quest.2A3D9FBC98774A7E.quest_desc: [
		"在末地中央龙岛挑战末影龙。"
		"准备弓箭、金苹果与充足治疗。"
		"击败后解锁末地城与鞘翅。"
	]
	quest.2A3D9FBC98774A7E.quest_subtitle: "终焉之战"
	quest.2A3D9FBC98774A7E.title: "末影龙讨伐"
	quest.2A455B18F6F66218.quest_desc: [
		"暮色最终 Boss，暗黑高塔上空。"
		"召唤火球与爪牙，血量极高。"
		"准备大量弓弩弹药与治疗。"
		"暮色主线完成！"
	]
	quest.2A455B18F6F66218.quest_subtitle: "高塔之巅"
	quest.2A455B18F6F66218.title: "暮初恶魂"
	quest.2C0A6D0EC40C766A.quest_desc: [
		"Artifacts 模组的神器：无尽的牛肉、熔岩之靴、羊驼披风等。"
		"它们散落在遗迹宝箱中。"
		"装备获得独特效果。"
	]
	quest.2C0A6D0EC40C766A.quest_subtitle: "探索战利品"
	quest.2C0A6D0EC40C766A.title: "神器饰品"
	quest.2CC69C0C75EC9D75.quest_desc: [
		"Refined Storage 提供数字存储网络。"
		"控制器 + 磁盘 = 大规模存储。"
		"无线终端随处访问。"
		"中期以后强烈推荐！"
	]
	quest.2CC69C0C75EC9D75.quest_subtitle: "数字仓库"
	quest.2CC69C0C75EC9D75.title: "精制存储 RS"
	quest.2D072479520225FC.quest_desc: [
		"用 3 羊毛 + 3 木板做一张床。"
		"睡觉能跳过夜晚并设置重生点。"
	]
	quest.2D072479520225FC.quest_subtitle: "夜晚的庇护"
	quest.2D072479520225FC.title: "安睡与重生"
	quest.2D59A32A99ED5EBE.quest_desc: [
		"下界石英用于红石与合成。"
		"地狱岩层中常见。"
		"挖石英注意岩浆。"
	]
	quest.2D59A32A99ED5EBE.quest_subtitle: "白色矿物"
	quest.2D59A32A99ED5EBE.title: "下界石英"
	quest.2D7F4CA9374AB0BB.quest_desc: [
		"难度调节器调整全局难度。"
		"高难度下怪物更强，掉落更丰。"
		"与你的实力匹配，享受挑战。"
	]
	quest.2D7F4CA9374AB0BB.quest_subtitle: "自定义挑战"
	quest.2D7F4CA9374AB0BB.title: "难度系统"
	quest.2DF39DE88E938CFA.quest_desc: [
		"难度调节器调整全局难度。"
		"更高难度：怪物更强、掉落更丰、阅历更多。"
		"低难度适合休闲探索。"
		"随时可调，选择适合你的节奏。"
	]
	quest.2DF39DE88E938CFA.quest_subtitle: "自定义挑战"
	quest.2DF39DE88E938CFA.title: "难度调节器"
	quest.2E1B84B260EA5FA4.quest_desc: ["目光即是攻击，注意走位。"]
	quest.2E1B84B260EA5FA4.quest_subtitle: "注视一切"
	quest.2E1B84B260EA5FA4.title: "观测者"
	quest.2E2034FD5ADFAAF4.quest_desc: ["水域穿梭，速度极快。"]
	quest.2E2034FD5ADFAAF4.quest_subtitle: "海妖传说"
	quest.2E2034FD5ADFAAF4.title: "斯库拉"
	quest.2E9D34119F3374CE.quest_desc: [
		"木板 + 铁锭合成盾牌。"
		"右键格挡减少大量伤害。"
		"与武器配合是近战标配。"
	]
	quest.2E9D34119F3374CE.quest_subtitle: "格挡的艺术"
	quest.2E9D34119F3374CE.title: "盾牌"
	quest.2EB2618C1266F6A9.quest_desc: [
		"黑曜石 + 末影之眼合成末影箱。"
		"每个玩家的末影箱内容独立且全局共享。"
		"配合潜影盒实现终极随身仓库。"
	]
	quest.2EB2618C1266F6A9.quest_subtitle: "跨空间存储"
	quest.2EB2618C1266F6A9.title: "末影箱"
	quest.2F01B7210760474F.quest_desc: [
		"金矿在 Y=-64~32 生成，下界更多。"
		"金用于合成、猪灵交易。"
		"装备金制物品可避免猪灵攻击。"
	]
	quest.2F01B7210760474F.quest_subtitle: "猪灵的最爱"
	quest.2F01B7210760474F.title: "金矿"
	quest.2F08F5EB273B58D8.quest_desc: ["{chapter.12.quest.25.description.1}"]
	quest.2F9225A107E24475.quest_desc: [
		"Modonomicon 提供各模组的游戏内指南书。"
		"在创造搜索或从模组获取。"
		"复杂的模组（光谱等）都有详细指南。"
		"不懂就读书！"
	]
	quest.2F9225A107E24475.quest_subtitle: "读书破万卷"
	quest.2F9225A107E24475.title: "Modonomicon 指南"
	quest.3003B874EC470373.quest_desc: [
		"锻造厂（Forge of Aeons）是锻造主题维度。"
		"巨大熔炉与机械造物。"
		"这里的守护者以锻造之力战斗。"
	]
	quest.3003B874EC470373.quest_subtitle: "锻造维度"
	quest.3003B874EC470373.title: "锻造厂"
	quest.309077656D4899C2.quest_desc: ["{chapter.12.quest.9.description.1}"]
	quest.309077656D4899C2.quest_subtitle: "{chapter.12.quest.9.subtitle}"
	quest.30F8CE4234D30BE2.quest_subtitle: "用于开启暮色森林传送门"
	quest.30F8CE4234D30BE2.title: "步入暮色"
	quest.30FF2936E2DF45B0.quest_desc: [
		"陨落圣殿（Sanctum Fallen）是神秘遗迹维度。"
		"悬浮的圣殿遗迹。"
		"隐藏着强大的力量。"
	]
	quest.30FF2936E2DF45B0.quest_subtitle: "神秘维度"
	quest.30FF2936E2DF45B0.title: "陨落圣殿"
	quest.31F3BC4709A0DAD7.quest_desc: [
		"箱子/木桶是基础存储。"
		"潜影盒随身携带（末地）。"
		"组织好你的仓库。"
	]
	quest.31F3BC4709A0DAD7.quest_subtitle: "箱子的学问"
	quest.31F3BC4709A0DAD7.title: "基础存储"
	quest.326C4515FBA399A7.quest_desc: [
		"大量 QoL 模组提升体验："
		"Jade（方块信息）、Xaero 地图、Appleskin（饱食）、EMI（配方）、Controlling（按键）、BetterF3（调试屏）、Inventory HUD 等。"
		"配置好快捷键，游戏更顺畅！"
	]
	quest.326C4515FBA399A7.quest_subtitle: "舒适游玩"
	quest.326C4515FBA399A7.title: "体验增强"
	quest.32949E1A7CEA3523.quest_desc: ["当你获得棕色颜料后便可打开棕色孢子花的门拿到鎏金之书"]
	quest.3374854BF7B08DB1.quest_desc: [
		"瞬移突袭。"
		"预判落点。"
	]
	quest.3374854BF7B08DB1.quest_subtitle: "末影造物"
	quest.3374854BF7B08DB1.title: "末影傀儡"
	quest.337AE5E877B10BC1.quest_desc: [
		"进入下界需要黑曜石与打火石。"
		"下界蕴藏石英、远古残骸等资源。"
		"注意恶魂、猪灵与烈焰人！"
	]
	quest.337AE5E877B10BC1.quest_subtitle: "烈焰与熔岩"
	quest.337AE5E877B10BC1.title: "下界"
	quest.342A014E8BAC0BE8.quest_desc: [
		"Backpacked 背包可穿戴。"
		"探险前背上，容量翻倍。"
		"升级版本容量更大。"
	]
	quest.342A014E8BAC0BE8.quest_subtitle: "走到哪装到哪"
	quest.342A014E8BAC0BE8.title: "随身背包"
	quest.342B58A3A0009BCB.quest_desc: [
		"推荐顿悟路线："
		"前期：生存/防御模块保命 → 攻击模块提输出。"
		"中期：剑之进化（进化之剑）→ 探索模块。"
		"后期：全模块精通。"
		"顿悟槽位有限，规划好优先级！"
	]
	quest.342B58A3A0009BCB.quest_subtitle: "如何选择"
	quest.342B58A3A0009BCB.title: "顿悟策略"
	quest.346CB1473CEF0DF6.quest_desc: [
		"{chapter.12.quest.3.description.1}"
		"{image:kubejs:textures/ftbq/10.png width:100 height:100 align:1}"
	]
	quest.34D0A8688691BAB0.quest_desc: [
		"More Villagers 为村庄带来更多职业。"
		"建造蓝图桌等职业站点，招募特殊村民。"
		"用绿宝石交易稀有物品。"
	]
	quest.34D0A8688691BAB0.quest_subtitle: "以物易物"
	quest.34D0A8688691BAB0.title: "村民与工匠"
	quest.34F02BD7100DC8B2.quest_desc: [
		"尽早获得进化之剑（顿悟「剑之进化」）。"
		"每击杀一个 Boss，剑的攻击伤害 +5。"
		"Boss 图鉴中的每个目标都是它的养料！"
	]
	quest.34F02BD7100DC8B2.quest_subtitle: "成长的武器"
	quest.34F02BD7100DC8B2.title: "进化之剑养成"
	quest.35EEEB73D2022C20.quest_desc: [
		"第一天：砍树、造工具、挖石头。"
		"尽快做出石制装备并找到食物来源。"
		"夜晚来临前建好庇护所。"
	]
	quest.35EEEB73D2022C20.quest_subtitle: "活下去"
	quest.35EEEB73D2022C20.title: "开局起步"
	quest.3634E1C8CF0A0E14.quest_desc: [
		"难度调节器调整游戏难度。"
		"更高难度：怪物更强、掉落更丰。"
		"选择适合你的节奏。"
	]
	quest.3634E1C8CF0A0E14.quest_subtitle: "自定义挑战"
	quest.3634E1C8CF0A0E14.title: "难度调节器"
	quest.3660C7ACAF4E08ED.quest_desc: [
		"{chapter.12.quest.53.description.1}"
		"{image:kubejs:textures/ftbq/jiyan.png width:180 height:100 align:1}"
	]
	quest.36FED93821C6D12B.quest_desc: [
		"Kaleidoscope Cookery 添加大量新食物与烹饪配方。"
		"注意：首次食用新食物获得阅历！"
		"多尝试不同食物。"
	]
	quest.36FED93821C6D12B.quest_subtitle: "舌尖上的整合包"
	quest.36FED93821C6D12B.title: "烹饪模组"
	quest.37CBDFEC78D528C5.quest_desc: [
		"本包用 KubeJS 定制了大量机制："
		"Boss 击杀记录（进化之剑）、食物首吃阅历、图鉴解锁阅历、集卡册阅历等。"
		"这些机制与顿悟系统深度联动。"
		"善用它们加速成长！"
	]
	quest.37CBDFEC78D528C5.quest_subtitle: "本包特色"
	quest.37CBDFEC78D528C5.title: "KubeJS 机制说明"
	quest.380B8D448CD2582B.quest_desc: ["{chapter.12.quest.6.description.1}"]
	quest.3858073E73BFA3D3.quest_desc: [
		"永恒之星是重要合成材料。"
		"通过难度调节器或其他途径获取。"
	]
	quest.3858073E73BFA3D3.quest_subtitle: "稀有材料"
	quest.3858073E73BFA3D3.title: "永恒之星"
	quest.38689F74FC60C316.quest_desc: [
		"观测者（The Watcher）监视着灾厄的世界。"
		"它的目光即是攻击，注意走位躲避。"
	]
	quest.38689F74FC60C316.quest_subtitle: "注视一切"
	quest.38689F74FC60C316.title: "观测者"
	quest.3899DECE76473D1D.quest_desc: ["{chapter.9.quest.2.description.1}"]
	quest.389A9378320C110A.quest_desc: [
		"失落堡垒是灾厄的最终挑战区域。"
		"这里盘踞着灾厄最强的守护者，做好准备再来！"
	]
	quest.389A9378320C110A.quest_subtitle: "Bastion Lost"
	quest.389A9378320C110A.title: "灾厄·失落堡垒"
	quest.38C77C2926DAA827.quest_desc: [
		"使用难度调节器调整游戏难度。"
		"更高难度：怪物更强，但掉落更丰厚。"
		"选择适合你的节奏。"
	]
	quest.38C77C2926DAA827.quest_subtitle: "自定义挑战"
	quest.38C77C2926DAA827.title: "难度系统"
	quest.39306979BEE3BA74.quest_desc: [
		"阅历（Aptitude）是升级心得点的货币："
		"击杀 Boss、进入新维度、首次食用食物、解锁新图鉴都能获得阅历。"
		"每获得 10 点阅历 +1 心得点。"
	]
	quest.39306979BEE3BA74.quest_subtitle: "获取方式"
	quest.39306979BEE3BA74.title: "阅历与心得点"
	quest.39BCCC18E1E065EB.quest_desc: [
		"暗黑森林城堡。"
		"隐身突袭，成群出现。"
		"听声音预判攻击。"
		"掉落幻影铠甲。"
	]
	quest.39BCCC18E1E065EB.quest_subtitle: "城堡之影"
	quest.39BCCC18E1E065EB.title: "幻影骑士"
	quest.39EA94DE7DD39CD7.quest_desc: [
		"暮色毕业后再挑战灾厄（Cataclysm）。"
		"灾厄有 8 个维度，Boss 强度远超暮色。"
		"灾厄核心材料用于高级合成。"
	]
	quest.39EA94DE7DD39CD7.quest_subtitle: "高难区域"
	quest.39EA94DE7DD39CD7.title: "灾厄挑战"
	quest.3A977758D7357A5B.quest_desc: ["{chapter.12.quest.38.description.1}"]
	quest.3C122B53D101D605.quest_desc: [
		"用 8 个圆石合成熔炉。"
		"熔炉用于冶炼矿物和烹饪食物，是生存的核心。"
	]
	quest.3C122B53D101D605.quest_subtitle: "烹饪与烧矿"
	quest.3C122B53D101D605.title: "熔炉与冶炼"
	quest.3C435F4C85C21151.quest_desc: [
		"灾厄（L_Ender's Cataclysm）是整合包的后期高难模组。"
		"它包含 8 个独立维度与 10+ 个强力 Boss。"
		"灾厄的 Boss 掉落核心材料，用于合成最强装备。"
		"建议：先完成暮色森林与光谱基础，装备成型后再来！"
	]
	quest.3C435F4C85C21151.quest_subtitle: "高难挑战"
	quest.3C435F4C85C21151.title: "灾厄简介"
	quest.3C58D69771D29D63.quest_desc: [
		"Mowzie's Mobs 添加了风格独特的巨兽生物。"
		"钢铁守护者、霜冻巨兽、雕刻家、太阳鸟。"
		"它们散落在世界各地，是进化之剑的养料。"
	]
	quest.3C58D69771D29D63.quest_subtitle: "远古巨兽"
	quest.3C58D69771D29D63.title: "Mowzie's Mobs"
	quest.3DABE93FB53EDDF5.quest_desc: [
		"先驱者（The Harbinger）预示灾厄降临。"
		"强大的远程攻击。"
		"保持移动躲避弹幕。"
	]
	quest.3DABE93FB53EDDF5.quest_subtitle: "灾厄使者"
	quest.3DABE93FB53EDDF5.title: "先驱者"
	quest.3F7878BD0E23B432.quest_desc: [
		"永恒冰封是一个冰霜主题的灾厄维度。"
		"这里有强大的冰霜生物与丰厚奖励。"
	]
	quest.3F7878BD0E23B432.quest_subtitle: "Eternal Frosthold"
	quest.3F7878BD0E23B432.title: "灾厄·永恒冰封"
	quest.3FBD5195FBCC4547.quest_desc: [
		"使用 KubeJS 的难度调节器可以调整游戏难度。"
		"高难度下怪物更强，但掉落与阅历收益也更高。"
		"选择适合你的难度，享受游戏！"
	]
	quest.3FBD5195FBCC4547.quest_subtitle: "掌握你的挑战"
	quest.3FBD5195FBCC4547.title: "难度调节器"
	quest.3FD3D4F9A36C114D.quest_desc: [
		"灵魂铁砧是一个亡灵主题的灾厄维度。"
		"小心亡灵大军，收集灵魂精华。"
	]
	quest.3FD3D4F9A36C114D.quest_subtitle: "Souls Anvil"
	quest.3FD3D4F9A36C114D.title: "灾厄·灵魂铁砧"
	quest.405FB85B4830AD82.quest_desc: [
		"暮色地形迷宫重重。"
		"合成暮色地图显示地形。"
		"还有矿图、迷宫图等变体。"
	]
	quest.405FB85B4830AD82.quest_subtitle: "不迷路的保证"
	quest.405FB85B4830AD82.title: "暮色地图"
	quest.40679BB3E5EE91AD.quest_desc: [
		"打造一套铁质护甲。"
		"铁装让你能应对大多数常规威胁。"
	]
	quest.40679BB3E5EE91AD.quest_subtitle: "小有所成"
	quest.40679BB3E5EE91AD.title: "铁装毕业"
	quest.41F63E4DA8343311.quest_desc: [
		"哔哔机是 Curios 饰品。"
		"完成各种任务时发出提示音效。"
		"装备后不错过任何任务完成。"
	]
	quest.41F63E4DA8343311.quest_subtitle: "任务提示"
	quest.41F63E4DA8343311.title: "哔哔机"
	quest.42DB0B956AF67442.quest_desc: [
		"命名牌给动物/仆从起名。"
		"钓鱼与地牢宝箱获得。"
		"仆从与宠物必备！"
	]
	quest.42DB0B956AF67442.quest_subtitle: "给宠物起名"
	quest.42DB0B956AF67442.title: "命名牌"
	quest.4355E479445EE1F4.quest_desc: ["{chapter.12.quest.58.description.1}"]
	quest.4480F414CD6F4ADA.quest_desc: [
		"钓鱼获得食物、宝藏与附魔书。"
		"Dungeons & Taverns 等地牢也在世界各处生成。"
	]
	quest.4480F414CD6F4ADA.quest_subtitle: "水边的收获"
	quest.4480F414CD6F4ADA.title: "垂钓时光"
	quest.44F05BA1279FD750.quest_desc: ["{chapter.12.quest.56.description.1}"]
	quest.44F05BA1279FD750.title: "{chapter.12.quest.56.title}"
	quest.451DD380D9CD172E.quest_desc: ["法老之灾（Pharaoh's Bane）是沙漠金字塔主题维度。"]
	quest.451DD380D9CD172E.quest_subtitle: "沙漠维度"
	quest.451DD380D9CD172E.title: "法老之灾"
	quest.471360EAD4D6DF14.quest_desc: [
		"凋灵骷髅掉落头颅（低概率）。"
		"3 个头颅 + 灵魂沙召唤凋灵。"
		"凋灵是进化之剑的成长目标！"
	]
	quest.471360EAD4D6DF14.quest_subtitle: "凋灵召唤"
	quest.471360EAD4D6DF14.title: "凋灵骷髅头"
	quest.473E65CEA7686F41.quest_desc: [
		"整合包内置大量 QoL 模组："
		"Jade（方块信息）、Xaero 地图、Appleskin（饱食显示）、EMI（配方查询）、Controlling（按键管理）。"
		"善用它们让游戏更顺畅！"
	]
	quest.473E65CEA7686F41.quest_subtitle: "舒适体验"
	quest.473E65CEA7686F41.title: "核心辅助模组"
	quest.4768B8C2BCE77921.quest_desc: [
		"击败凋灵获下界之星。"
		"信标提供范围增益（速度/力量/急迫等）。"
		"铁块金字塔放大效果。"
	]
	quest.4768B8C2BCE77921.quest_subtitle: "增益光环"
	quest.4768B8C2BCE77921.title: "信标"
	quest.48B717F28D4E847B.quest_desc: [
		"优先收集常见生物的卡片（容易重复）。"
		"重复卡片可分解或交易。"
		"与 Field Guide 图鉴互补。"
	]
	quest.48B717F28D4E847B.quest_subtitle: "收集指南"
	quest.48B717F28D4E847B.title: "集卡策略"
	quest.48F57785B56CE5C5.quest_desc: ["{chapter.12.quest.16.description.1}"]
	quest.48F57785B56CE5C5.quest_subtitle: "{chapter.12.quest.16.subtitle}"
	quest.490AFFEC3212B899.quest_desc: [
		"末影龙盘踞末地龙岛。"
		"击杀掉落经验并开启末地城。"
		"推荐：附魔弓、金苹果、落地防护。"
	]
	quest.490AFFEC3212B899.quest_subtitle: "终焉之王"
	quest.490AFFEC3212B899.title: "末影龙"
	quest.4929277AC11875DD.title: "{chapter.12.quest.71.title}"
	quest.494C83C4596F5FF0.quest_desc: ["{chapter.12.quest.47.description.1}"]
	quest.494C83C4596F5FF0.title: "{chapter.12.quest.47.title}"
	quest.4A7CF48DCE22C8BE.quest_desc: [
		"雪怪首领在积雪森林的洞穴。"
		"投掷冰块、猛烈锤击。"
		"洞穴狭窄，注意躲避。"
	]
	quest.4A7CF48DCE22C8BE.quest_subtitle: "雪怪首领"
	quest.4A7CF48DCE22C8BE.title: "雪山之巅"
	quest.4ADEA4FA1526CE3E.quest_desc: ["{chapter.12.quest.55.description.1}"]
	quest.4CAB3209EB83425D.quest_desc: [
		"穿越传送门进入暮色森林。"
		"暮色有独特生态：蘑菇森林、暗黑森林、雪山、冰川。"
		"这里的时间永远定格在黄昏。"
		"小心：暮色的夜晚同样危险。"
	]
	quest.4CAB3209EB83425D.quest_subtitle: "新世界"
	quest.4CAB3209EB83425D.title: "进入暮色"
	quest.4CE237AE8F58B2CB.quest_desc: ["{chapter.12.quest.19.description.1}"]
	quest.4CE9B355B43E155E.quest_desc: [
		"{chapter.12.quest.14.description.1}"
		"{image:kubejs:textures/ftbq/moon.png width:170 height:140 align:1}"
		"{chapter.12.quest.14.description.2}"
	]
	quest.4D9E8822ADD4BC89.quest_desc: [
		"用锄头开垦农田，种植小麦。"
		"农业提供稳定的食物来源。"
	]
	quest.4D9E8822ADD4BC89.quest_subtitle: "自给自足"
	quest.4D9E8822ADD4BC89.title: "农田开垦"
	quest.4DC63D1752013975.quest_desc: ["{chapter.12.quest.24.description.1}"]
	quest.4E1532E2E3308C7F.quest_desc: [
		"焰魔（Ignis）是灾厄最知名的 Boss。"
		"它浑身烈焰，喷吐火球与烈焰冲击。"
		"推荐：火焰抗性 + 远程风筝。"
		"击败后获得灾厄核心材料。"
	]
	quest.4E1532E2E3308C7F.quest_subtitle: "灾厄的标志"
	quest.4E1532E2E3308C7F.title: "焰魔"
	quest.4E2FE981B29EE11B.quest_desc: [
		"找到或放置路石并右键激活。"
		"之后可在路石间传送。"
		"背包里的传送卷轴也能用！"
		"路石是长途探索的最佳伴侣。"
	]
	quest.4E2FE981B29EE11B.quest_subtitle: "传送网络"
	quest.4E2FE981B29EE11B.title: "路石"
	quest.4EADBCC6AAC062D6.quest_desc: [
		"收集黄水晶、紫水晶等各色水晶碎片。"
		"不同水晶对应不同的光谱能量。"
	]
	quest.4EADBCC6AAC062D6.quest_subtitle: "多彩的力量"
	quest.4EADBCC6AAC062D6.title: "光谱水晶"
	quest.4F309FFEA518F32C.quest_desc: [
		"红石是自动化与机关的核心。"
		"配合 Refined Storage 等模组实现自动化。"
	]
	quest.4F309FFEA518F32C.quest_subtitle: "科技与自动化"
	quest.4F309FFEA518F32C.title: "红石"
	quest.4F507917FD331CA5.quest_desc: ["{chapter.12.quest.2.description.1}"]
	quest.4F507917FD331CA5.title: "{chapter.12.quest.2.title}"
	quest.4F511210D472406E.quest_desc: [
		"末影龙喷吐的龙息可收集（玻璃瓶）。"
		"酿造滞留药水。"
		"战斗时在龙尾附近收集。"
	]
	quest.4F511210D472406E.quest_subtitle: "酿造精华"
	quest.4F511210D472406E.title: "龙息"
	quest.4FA113E035EE0D64.quest_desc: [
		"冰雪女王在极光宫殿。"
		"召唤冰晶守卫、发射冰刺。"
		"宫殿顶层是最终战场。"
	]
	quest.4FA113E035EE0D64.quest_subtitle: "冰雪女王"
	quest.4FA113E035EE0D64.title: "极光宫殿"
	quest.4FA6BFF5B11A4EC3.quest_desc: [
		"{chapter.12.quest.43.description.1}"
		"{image:kubejs:textures/ftbq/spectrum_relic.png width:256 height:137 align:1}"
		"{chapter.12.quest.43.description.2}"
	]
	quest.4FA6BFF5B11A4EC3.title: "{chapter.12.quest.43.title}"
	quest.50196DC829EF6061.quest_desc: ["{chapter.12.quest.10.description.1}"]
	quest.50196DC829EF6061.title: "{chapter.12.quest.10.title}"
	quest.506B54553A52830B.quest_desc: [
		"收集 12 颗钻石，扔进 2×2 的水池中。"
		"水面会出现通往暮色森林的传送门。"
	]
	quest.506B54553A52830B.quest_subtitle: "童话之门"
	quest.506B54553A52830B.title: "开启暮色传送门"
	quest.515D3C2DC0BFA8C1.quest_desc: ["{chapter.12.quest.68.description.1}"]
	quest.515D3C2DC0BFA8C1.quest_subtitle: "{chapter.12.quest.68.subtitle}"
	quest.517EE5BB9CDA1A2A.quest_desc: [
		"Comforts 提供睡袋与吊床。"
		"吊床可悬挂使用，睡袋随处可睡。"
		"在野外也能跳过夜晚。"
	]
	quest.517EE5BB9CDA1A2A.quest_subtitle: "旅途休憩"
	quest.517EE5BB9CDA1A2A.title: "露营"
	quest.51A7BA308554606F.quest_desc: ["后面的内容请先自行看光谱世界书"]
	quest.51A7BA308554606F.quest_subtitle: "破坏最底层的毁蚀微生物以开启传送门"
	quest.51A7BA308554606F.title: "进入更深的地方"
	quest.52618EFB4027816B.quest_desc: ["永恒冰封（Eternal Frosthold）是冰霜主题维度。"]
	quest.52618EFB4027816B.quest_subtitle: "冰霜维度"
	quest.52618EFB4027816B.title: "永恒冰封"
	quest.52C87CD7A0FCBB80.quest_desc: [
		"先砍树获得原木，制作工作台。"
		"工作台是几乎所有合成的基础，尽快做出来。"
	]
	quest.52C87CD7A0FCBB80.quest_subtitle: "生存第一步"
	quest.52C87CD7A0FCBB80.title: "砍树与工作台"
	quest.53A5F9E22D1CEA53.quest_desc: [
		"咒翼灵骸（Maledictus）是灾厄的神秘 Boss。"
		"它挥舞诅咒之翼发动灵魂攻击。"
	]
	quest.53A5F9E22D1CEA53.quest_subtitle: "诅咒之翼"
	quest.53A5F9E22D1CEA53.title: "咒翼灵骸"
	quest.53F69E71BEFAB57B.quest_desc: [
		"用小麦繁殖牛、羊、猪。"
		"烹饪肉类获得更高的饱食度。"
	]
	quest.53F69E71BEFAB57B.quest_subtitle: "肉食供应"
	quest.53F69E71BEFAB57B.title: "畜牧养殖"
	quest.5441F04C53578811.quest_desc: [
		"暮色森林的 Boss 掉落强力装备。"
		"娜迦掉落娜迦鳞甲套装。"
		"击败暮色各 Boss 收集完整套装！"
	]
	quest.5441F04C53578811.quest_subtitle: "Boss 战利品"
	quest.5441F04C53578811.title: "暮色装备"
	quest.54B18C774EF22FE1.quest_desc: ["{chapter.12.quest.41.description.1}"]
	quest.5587E918EADADC9B.quest_desc: [
		"巫妖塔顶层，使用魔法战斗。"
		"掉落巫师权杖。"
	]
	quest.5587E918EADADC9B.quest_subtitle: "暮色法师"
	quest.5587E918EADADC9B.title: "巫妖"
	quest.55F31FFFA9AB2411.quest_desc: [
		"恭喜完成新手教程！"
		"接下来：探索维度、收集装备、挑战 Boss。"
		"记住顿悟系统（K 键）——它是你成长的核心！"
	]
	quest.55F31FFFA9AB2411.quest_subtitle: "旅程开始"
	quest.55F31FFFA9AB2411.title: "新手毕业"
	quest.5637FEB12ADC8EB3.quest_desc: ["{chapter.12.quest.12.description.1}"]
	quest.5637FEB12ADC8EB3.title: "{chapter.12.quest.12.title}"
	quest.56AAEF01957A0B51.quest_desc: [
		"受击自动闪避（消耗层数）。"
		"过热后恢复。"
		"高难度保命神器。"
	]
	quest.56AAEF01957A0B51.quest_subtitle: "闪避饰品"
	quest.56AAEF01957A0B51.title: "预知眼"
	quest.56E4502CB2030DB1.quest_desc: [
		"Backpacked 模组提供随身背包。"
		"背包让你在外出时有更多空间。"
	]
	quest.56E4502CB2030DB1.quest_subtitle: "随身仓库"
	quest.56E4502CB2030DB1.title: "旅行背包"
	quest.56E89E0BEC14B19C.quest_desc: [
		"末影龙盘踞末地龙岛。"
		"先摧毁末影水晶，再攻击本体。"
		"推荐：附魔弓、金苹果、落地防护。"
		"击杀后获得大量经验并开启末地城。"
	]
	quest.56E89E0BEC14B19C.quest_subtitle: "终焉之王"
	quest.56E89E0BEC14B19C.title: "末影龙"
	quest.56F7E5AB654115CE.quest_desc: ["{chapter.12.quest.50.description.1}"]
	quest.57A19E3BCEC1B133.quest_desc: [
		"进化之剑是本包的招牌武器。"
		"每击杀一个 Boss，攻击伤害 +5（手持时属性面板可见）。"
		"按住 Shift 查看已击杀 Boss 列表。"
		"获得：顿悟「剑之进化」或任务奖励。"
	]
	quest.57A19E3BCEC1B133.quest_subtitle: "会成长的武器"
	quest.57A19E3BCEC1B133.title: "进化之剑"
	quest.57B9DD9B38F6E11E.quest_desc: [
		"幸运7 是一件 Curios 饰品。"
		"每第 7 次攻击造成 77%~777% 的随机伤害！"
		"装备在饰品栏的护符槽位即可生效。"
	]
	quest.57B9DD9B38F6E11E.quest_subtitle: "幸运饰物"
	quest.57B9DD9B38F6E11E.title: "幸运7"
	quest.58CB04E34DFCAC0D.quest_desc: ["{chapter.12.quest.21.description.1}"]
	quest.59D6B500E090C86B.quest_desc: ["{chapter.12.quest.18.description.1}"]
	quest.5A185D7F1A427109.quest_desc: [
		"Artifacts 神器都在遗迹宝箱中："
		"地牢、矿井、神殿、村庄等。"
		"多探索地牢，收集全部神器！"
	]
	quest.5A185D7F1A427109.quest_subtitle: "地牢寻宝"
	quest.5A185D7F1A427109.title: "探索神器"
	quest.5BDD9D290D63ECE7.quest_desc: [
		"饰品选择看需求："
		"打 Boss → 幸运7（爆发）+ 预知眼（保命）。"
		"探索 → 哔哔机 + 神器。"
		"根据场景自由组合！"
	]
	quest.5BDD9D290D63ECE7.quest_subtitle: "策略"
	quest.5BDD9D290D63ECE7.title: "饰品搭配"
	quest.5CC8D2A1F4AAF533.quest_desc: [
		"潜行右键取下管道,右键可以将组件卸下"
		""
	]
	quest.5D05AD7853C1F76E.quest_desc: [
		"石剑是前期最实惠的武器。"
		"夜晚的僵尸、骷髅、蜘蛛都很危险。"
		"顺手做一面盾牌！"
	]
	quest.5D05AD7853C1F76E.quest_subtitle: "防身必备"
	quest.5D05AD7853C1F76E.title: "武器"
	quest.5D2CCE8038A39D5E.quest_desc: [
		"用 4 个木板合成工作台。"
		"工作台解锁 3×3 合成网格，几乎所有物品都需要它。"
		"放置后右键使用。"
	]
	quest.5D2CCE8038A39D5E.quest_subtitle: "合成核心"
	quest.5D2CCE8038A39D5E.title: "工作台"
	quest.5D331D77BFF11B48.quest_desc: [""]
	quest.5D331D77BFF11B48.quest_subtitle: "{chapter.12.quest.36.subtitle}"
	quest.5D331D77BFF11B48.title: "{chapter.12.quest.36.title}"
	quest.5DD02E2AA0578752.quest_desc: [
		"击败巨兽获得武器与装备。"
		"长矛是 Mowzie 的标志武器。"
		"巨兽材料可制作高级装备。"
	]
	quest.5DD02E2AA0578752.quest_subtitle: "狩猎战利品"
	quest.5DD02E2AA0578752.title: "巨兽武器"
	quest.5E210CF7E49C569C.quest_desc: ["{chapter.12.quest.8.description.1}"]
	quest.5E210CF7E49C569C.title: "{chapter.12.quest.8.title}"
	quest.5EAB171F4402FF2D.quest_desc: [
		"高速水中穿梭。"
		"注意立足点。"
	]
	quest.5EAB171F4402FF2D.quest_subtitle: "海妖传说"
	quest.5EAB171F4402FF2D.title: "斯库拉"
	quest.5EF371628CAF40D7.title: "{chapter.12.quest.70.title}"
	quest.5FBDB3162466DBD9.quest_desc: ["{chapter.9.quest.1.description.1}"]
	quest.60828A261E819292.quest_desc: [
		"光谱提供多种武器：水晶剑、基岩剑等。"
		"逐步解锁更强大的光谱武器。"
		"基岩系列是光谱战力的巅峰。"
	]
	quest.60828A261E819292.quest_subtitle: "魔法武器线"
	quest.60828A261E819292.title: "光谱武器"
	quest.61407E4973BFDDF0.quest_desc: [
		"主世界生成大量地标：地牢、矿井、村庄、遗迹。"
		"使用 YUNG 系列结构模组改善的遗迹探索。"
		"死亡不掉落？不存在的——小心为上！"
	]
	quest.61407E4973BFDDF0.quest_subtitle: "地标与遗迹"
	quest.61407E4973BFDDF0.title: "主世界奇观"
	quest.61628DB272EB8907.quest_desc: [
		"防御极高。"
		"避免正面硬拼。"
	]
	quest.61628DB272EB8907.quest_subtitle: "金属怪物"
	quest.61628DB272EB8907.title: "下界合金巨兽"
	quest.6164C15A5FBDC286.quest_desc: ["{chapter.19.quest.34.description.1}"]
	quest.6164C15A5FBDC286.quest_subtitle: "{chapter.19.quest.34.subtitle}"
	quest.6164C15A5FBDC286.title: "{chapter.19.quest.34.title}"
	quest.617AF69B1A6A6DBD.quest_desc: [
		"用末影珍珠 + 烈焰粉合成末影之眼。"
		"用末影之眼定位要塞，激活末地传送门。"
	]
	quest.617AF69B1A6A6DBD.quest_subtitle: "终焉之路"
	quest.617AF69B1A6A6DBD.title: "寻找末地"
	quest.64B858F9A3E247CB.quest_desc: [
		"剪刀剪羊毛不伤害羊、剪树叶得树苗。"
		"也用于很多模组配方。"
	]
	quest.64B858F9A3E247CB.quest_subtitle: "羊毛与树叶"
	quest.64B858F9A3E247CB.title: "剪刀"
	quest.64F8CAE2AB24B228.quest_desc: [
		"预知眼是 Curios 饰品。"
		"装备获得预知眼层数，受击自动闪避并消耗层数。"
		"层数归零后过热，随后恢复。"
		"高难度下几乎是必需品。"
	]
	quest.64F8CAE2AB24B228.quest_subtitle: "预知与闪避"
	quest.64F8CAE2AB24B228.title: "不完善的预知眼"
	quest.651C28CAE854B433.quest_desc: ["{chapter.12.quest.60.description.1}"]
	quest.6560F3358C8B4EC4.quest_desc: [
		"幻影骑士与幻影领主守卫暗黑森林的城堡。"
		"它们会隐身并突然袭击。"
		"击败后获得幻影铠甲等战利品。"
	]
	quest.6560F3358C8B4EC4.quest_subtitle: "黑暗城堡之影"
	quest.6560F3358C8B4EC4.title: "幻影骑士"
	quest.65C1FF66C15D29D9.quest_desc: [
		"陨落圣殿是一个神秘的灾厄维度。"
		"这里的圣殿遗迹隐藏着强大的力量。"
	]
	quest.65C1FF66C15D29D9.quest_subtitle: "Sanctum Fallen"
	quest.65C1FF66C15D29D9.title: "灾厄·陨落圣殿"
	quest.66185FED92AEE8F4.quest_desc: [
		"法老之灾（Pharaoh's Bane）是沙漠金字塔主题。"
		"迷宫般的金字塔内部。"
		"法老的诅咒守护着宝藏。"
	]
	quest.66185FED92AEE8F4.quest_subtitle: "沙漠维度"
	quest.66185FED92AEE8F4.title: "法老之灾"
	quest.689C8C17F83821A1.quest_desc: [
		"Field Guide 图鉴记录你发现的生物。"
		"击杀或扫描新生物解锁图鉴条目。"
		"按图鉴快捷键查看已解锁条目。"
	]
	quest.689C8C17F83821A1.quest_subtitle: "探索与收集"
	quest.689C8C17F83821A1.title: "Field Guide 图鉴"
	quest.691A82DC4003E532.quest_desc: [
		"光谱的合成围绕基座（Pedestal）等装置。"
		"先制作基础基座，搭建光谱工坊。"
		"参考光谱指南的摆放要求。"
	]
	quest.691A82DC4003E532.quest_subtitle: "合成核心"
	quest.691A82DC4003E532.title: "光谱基座"
	quest.698B07E7D62E2E78.quest_desc: [
		"随着资源增多，箱子不够用了。"
		"可以用木桶、精制存储（Sophisticated Storage）等扩展存储。"
		"善用物品栏整理快捷键整理物资。"
	]
	quest.698B07E7D62E2E78.quest_subtitle: "整理物资"
	quest.698B07E7D62E2E78.title: "存储扩容"
	quest.6A70688CE69F99FB.quest_desc: ["{chapter.12.quest.45.description.1}"]
	quest.6ACAC6A1FEAE25A3.quest_desc: [
		"地狱之口是一个烈焰主题的灾厄维度。"
		"击败这里的守护者以获得灾厄核心材料。"
	]
	quest.6ACAC6A1FEAE25A3.quest_subtitle: "Inferno's Maw"
	quest.6ACAC6A1FEAE25A3.title: "灾厄·地狱之口"
	quest.6C47B6AC84B6C0F4.quest_desc: [
		"{chapter.12.quest.37.description.1}"
		"{image:kubejs:textures/ftbq/2023-07-28_19.57.46.png width:128 height:123 align:1}"
	]
	quest.6C549B8189876609.quest_desc: ["{chapter.12.quest.48.description.1}"]
	quest.6C549B8189876609.title: "{chapter.12.quest.48.title}"
	quest.6CD923D48AF77852.quest_desc: ["{chapter.12.quest.27.description.1}"]
	quest.6CD923D48AF77852.quest_subtitle: "{chapter.12.quest.27.subtitle}"
	quest.6CE26B24CB40E642.quest_desc: ["{chapter.12.quest.46.description.1}"]
	quest.6CFC7403D75E173E.quest_desc: [
		"恭喜完成新手教程！"
		"下一步建议："
		"① 挖钻石（Y=-59）"
		"② 去主世界探索（见「主世界探索」）"
		"③ 准备开启暮色传送门（12 钻石）"
		"记住：顿悟（K）和进化之剑（Boss 成长）是你长期变强的核心！"
	]
	quest.6CFC7403D75E173E.quest_subtitle: "旅程开始"
	quest.6CFC7403D75E173E.title: "新手毕业"
	quest.6D1E31042946C339.quest_desc: [
		"Waystones 模组提供传送路石。"
		"右键激活路石，之后可快速传送。"
		"在背包里也能使用传送卷轴！"
	]
	quest.6D1E31042946C339.quest_subtitle: "畅行天下"
	quest.6D1E31042946C339.title: "路石传送"
	quest.6DD1E9341E34E29A.quest_desc: ["{chapter.12.quest.39.description.1}"]
	quest.6ECFD8FA28F0009A.quest_desc: [
		"光谱后期会出现强大的怪物（Monstrosity）。"
		"它守护着光谱的珍稀资源。"
		"击败它获得光谱稀有材料。"
		"它也是进化之剑的成长目标！"
	]
	quest.6ECFD8FA28F0009A.quest_subtitle: "强大的守护者"
	quest.6ECFD8FA28F0009A.title: "光谱怪物"
	quest.6F4F9D2BBF37887C.quest_desc: [
		"种小麦、钓鱼或猎杀动物获得食物。"
		"面包是最基础的便携食物。"
	]
	quest.6F4F9D2BBF37887C.quest_subtitle: "别饿肚子"
	quest.6F4F9D2BBF37887C.title: "食物来源"
	quest.6FABEC58659F2E35.quest_desc: [
		"Curios 提供独立饰品栏位："
		"护符、戒指、腰带等槽位可装备特殊饰品。"
		"幸运7、预知眼、哔哔机都是 Curios 饰品。"
	]
	quest.6FABEC58659F2E35.quest_subtitle: "自由搭配"
	quest.6FABEC58659F2E35.title: "Curios 饰品系统"
	quest.6FBC36D7ADBB5CF9.quest_desc: [
		"Servantry 提供可驯服的仆从。"
		"招募仆从与你并肩作战。"
		"进阶仆从有专属装备与能力。"
	]
	quest.6FBC36D7ADBB5CF9.quest_subtitle: "并肩作战"
	quest.6FBC36D7ADBB5CF9.title: "仆从系统 Servantry"
	quest.6FE26D3D5BFDB85F.quest_desc: [
		"击败巨兽获得独特武器与装备。"
		"长矛是 Mowzie 系列的标志武器。"
	]
	quest.6FE26D3D5BFDB85F.quest_subtitle: "狩猎的战利品"
	quest.6FE26D3D5BFDB85F.title: "巨兽武器"
	quest.7128F82FA4A706F4.quest_desc: [
		"永恒冰封（Eternal Frosthold）是冰霜主题维度。"
		"暴风雪与冰晶生物。"
		"寒冷伤害需要注意——保暖装备。"
	]
	quest.7128F82FA4A706F4.quest_subtitle: "冰霜维度"
	quest.7128F82FA4A706F4.title: "永恒冰封"
	quest.715195FE8612B929.quest_desc: ["{chapter.12.quest.28.description.1}"]
	quest.716343CB40FF2863.quest_desc: [
		"末影箱内容全局共享。"
		"配合潜影盒 = 终极随身仓库。"
		"探险必备。"
	]
	quest.716343CB40FF2863.quest_subtitle: "跨维度存取"
	quest.716343CB40FF2863.title: "末影箱"
	quest.71722F244F58D669.quest_desc: [
		"先做木镐，挖 3 个圆石做石镐。"
		"石镐能挖铁矿石，是升级的关键。"
		"工具顺序：木→石→铁→钻石→下界合金。"
	]
	quest.71722F244F58D669.quest_subtitle: "工具升级"
	quest.71722F244F58D669.title: "木镐与石镐"
	quest.719E01FCD3FE22A4.quest_desc: [
		"船是跨海探索最快的载具。"
		"5 个木板合成。"
		"小心落水！"
	]
	quest.719E01FCD3FE22A4.quest_subtitle: "渡海利器"
	quest.719E01FCD3FE22A4.title: "水路航行"
	quest.727AC493F445255B.quest_desc: [
		"远程弹幕强大。"
		"保持移动。"
	]
	quest.727AC493F445255B.quest_subtitle: "灾厄使者"
	quest.727AC493F445255B.title: "先驱者"
	quest.738EC65A3C5D8366.quest_desc: [""]
	quest.73931BDB2A0DF3DB.quest_desc: [
		"钻石集中在 Y=-59 附近（深板岩层）。"
		"需要铁镐以上才能开采。"
		"钻石 = 高级装备 + 暮色传送门（12 颗）。"
	]
	quest.73931BDB2A0DF3DB.quest_subtitle: "珍贵矿物"
	quest.73931BDB2A0DF3DB.title: "钻石"
	quest.73A0D71EF5B35DE3.quest_desc: [
		"末影守卫（Ender Guardian）守护灾厄的末影区域。"
		"它拥有强大的近战与投射攻击。"
	]
	quest.73A0D71EF5B35DE3.quest_subtitle: "末影的守护者"
	quest.73A0D71EF5B35DE3.title: "末影守卫"
	quest.74358F64A7B34614.quest_desc: [
		"光谱后期会出现强大的怪物（Monstrosity）。"
		"击败它获得光谱的珍稀材料。"
		"它也是进化之剑的成长目标之一！"
	]
	quest.74358F64A7B34614.quest_subtitle: "强大的守护者"
	quest.74358F64A7B34614.title: "光谱怪物"
	quest.7567DE1CB217C515.quest_desc: [
		"娜迦是暮色第一个 Boss，在娜迦庭院。"
		"它横冲直撞，注意闪避。"
		"击败后获得娜迦鳞片。"
	]
	quest.7567DE1CB217C515.quest_subtitle: "第一位 Boss"
	quest.7567DE1CB217C515.title: "娜迦庭院"
	quest.75EB3CA204BE74C1.quest_desc: [
		"{chapter.12.quest.54.description.1}"
		"{image:kubejs:textures/ftbq/tiaose.png width:196 height:126 align:1}"
		"{chapter.12.quest.54.description.2}"
	]
	quest.75EB3CA204BE74C1.title: "{chapter.12.quest.54.title}"
	quest.76629036263B3588.quest_desc: [
		"挑战所有 Boss，集齐图鉴。"
		"完成各模组的主线。"
		"打造最强装备，成为这个世界的传奇！"
	]
	quest.76629036263B3588.quest_subtitle: "成为传奇"
	quest.76629036263B3588.title: "终局目标"
	quest.76CD21804384CF1E.quest_desc: ["锻造厂（Forge of Aeons）是锻造主题维度。"]
	quest.76CD21804384CF1E.quest_subtitle: "锻造维度"
	quest.76CD21804384CF1E.title: "锻造厂"
	quest.79352E8E51E56E91.quest_desc: [
		"全部完成后："
		"你已是这个世界的传奇。"
		"享受冒险，或挖掘隐藏内容。"
		"感谢游玩 if-1.3！"
	]
	quest.79352E8E51E56E91.quest_subtitle: "成为传奇"
	quest.79352E8E51E56E91.title: "终局目标"
	quest.7945125249DD7028.quest_desc: ["{chapter.12.quest.20.description.1}"]
	quest.7945125249DD7028.quest_subtitle: "{chapter.12.quest.20.subtitle}"
	quest.7AACC55C1BC80F2A.quest_desc: ["{chapter.12.quest.11.description.1}"]
	quest.7ABCD25967260037.quest_desc: [
		"灾变模组带来了多个危险维度。"
		"深渊（Abyssal Depths）是第一个挑战区域。"
		"这里的怪物更强，掉落更丰厚。"
	]
	quest.7ABCD25967260037.quest_subtitle: "Cataclysm 的起点"
	quest.7ABCD25967260037.title: "灾厄·深渊"
	quest.7B51BFDD655E1281.quest_desc: ["{chapter.12.quest.15.description.1}"]
	quest.7B51BFDD655E1281.quest_subtitle: "懒得想配方了,先放在这"
	quest.7BD9945C70E88D38.quest_desc: ["{chapter.12.quest.52.description.1}"]
	quest.7BF30ECF34165771.quest_desc: [
		"完成所有 Epiphany 模块。"
		"点亮全部心得，激活全部顿悟。"
		"你是顿悟大师！"
	]
	quest.7BF30ECF34165771.quest_subtitle: "知识巅峰"
	quest.7BF30ECF34165771.title: "顿悟全通"
	quest.7CCA01C1EF73E6F6.quest_desc: [
		"预知眼是一件 Curios 饰品。"
		"装备时获得预知眼层数，受击自动闪避。"
		"预知眼归零后进入过热，随后恢复。"
	]
	quest.7CCA01C1EF73E6F6.quest_subtitle: "预知与闪避"
	quest.7CCA01C1EF73E6F6.title: "不完善的预知眼"
	quest.7D5CDB74F2C76D75.quest_desc: [
		"1: 首次击杀 Boss → 心得点 +1"
		"2: 首次进入新维度 → 心得点 +1"
		"3: 集卡册 - 首次获得卡牌 → 阅历"
		"// 每张卡牌仅首次获得时发放; 稀有度越高阅历越多:"
		"//   普通+1 / 罕见+2 / 稀有+3 / 史诗+4 / 传说+5 / 神话+6"
		"4: 食物首吃 → 阅历"
		"// 每吃一种食物(不重复)按物品标签发放阅历:"
		"//   金食物 +3, 成品菜肴/熟肉 +3, 水果/浆果 +2, 生食原材料(生肉/农作物/蔬菜) +1"
		"5: 解锁新图鉴 → 阅历 +2"
	]
	quest.7D5CDB74F2C76D75.title: "如何获取阅历与心得"
	quest.7D6625A6144DE062.quest_desc: [
		"火焰沼泽，多头喷火，头可再生。"
		"推荐远程输出。"
	]
	quest.7D6625A6144DE062.quest_subtitle: "火之巨兽"
	quest.7D6625A6144DE062.title: "九头蛇"
	quest.7D6F9B4FE5AAF10E.quest_desc: [
		"进化之剑是本包的招牌武器。"
		"机制：每击杀一个 Boss，攻击伤害 +5。"
		"手持时属性面板可见加成；按住 Shift 查看已击杀 Boss 列表。"
		"获得方式：顿悟「剑之进化」或任务奖励。"
		"它是你贯穿全程的伙伴——Boss 图鉴里的每个目标都在喂养它！"
	]
	quest.7D6F9B4FE5AAF10E.quest_subtitle: "会成长的武器"
	quest.7D6F9B4FE5AAF10E.title: "进化之剑"
	quest.7DCB56A33C24D9D6.quest_desc: [
		"月光怀表显示当前月相与时间。"
		"月相影响部分模组机制。"
	]
	quest.7DCB56A33C24D9D6.quest_subtitle: "月相观测"
	quest.7DCB56A33C24D9D6.title: "月光怀表"
	quest.7E097322277CEA03.quest_desc: [
		"焰魔（Ignis）是灾厄模组的标志性 Boss。"
		"它浑身烈焰，喷吐火球，在灾厄维度中出没。"
		"击败后获得灾厄核心材料。"
	]
	quest.7E097322277CEA03.quest_subtitle: "灾厄的烈焰"
	quest.7E097322277CEA03.title: "焰魔"
	quest.7E38E74319CD75AA.quest_desc: [
		"锻造台升级下界合金剑。"
		"之后可以附魔强化。"
		"再往后就是各模组的进阶装备了。"
	]
	quest.7E38E74319CD75AA.quest_subtitle: "战力巅峰"
	quest.7E38E74319CD75AA.title: "下界合金剑"
	quest.7E8358CFBF84CD30.quest_desc: [
		"利维坦栖息在灾厄的海洋区域。"
		"它是巨大的海怪，攻击范围惊人。"
		"推荐：水域作战装备。"
	]
	quest.7E8358CFBF84CD30.quest_subtitle: "深海巨兽"
	quest.7E8358CFBF84CD30.title: "利维坦"
	quest.7E9186EDED489A36.quest_desc: [
		"穿越传送门进入暮色森林。"
		"暮色有独特的方块与矿物（铁木、钢叶等）。"
	]
	quest.7E9186EDED489A36.quest_subtitle: "新世界"
	quest.7E9186EDED489A36.title: "进入暮色"
	quest.7E9291638F5BB78C.quest_desc: [
		"黄昏之钟是一件神秘物品。"
		"它象征着黄昏时刻的力量。"
		"更多用途等待你的探索。"
	]
	quest.7E9291638F5BB78C.quest_subtitle: "黄昏的见证"
	quest.7E9291638F5BB78C.title: "黄昏之钟"
	quest.7FEB1850709B6C3B.quest_desc: [
		"卡片分稀有度：普通、稀有、史诗、神话等。"
		"稀有度越高，首次获得的阅历越多（普通+1…神话+6）。"
		"集齐整套卡片有额外奖励！"
	]
	quest.7FEB1850709B6C3B.quest_subtitle: "品质越高越值钱"
	quest.7FEB1850709B6C3B.title: "卡片稀有度"
	quest.8069C8033A4E6ACC.quest_desc: [
		"幻影骑士守卫暗黑森林的城堡。"
		"它们隐身突袭，注意聆听脚步声。"
	]
	quest.8069C8033A4E6ACC.quest_subtitle: "幻影骑士"
	quest.8069C8033A4E6ACC.title: "暗黑城堡"
	quest.8099F4EFBACEA67C.quest_desc: [
		"Backpacked 提供可穿戴背包。"
		"把背包放在胸甲栏位？不——它有自己的槽位。"
		"探索时容量翻倍。"
	]
	quest.8099F4EFBACEA67C.quest_subtitle: "随身仓库"
	quest.8099F4EFBACEA67C.title: "旅行背包"
	quest.80CA1607D0153EBE.quest_desc: [
		"Artifacts 神器：无尽牛肉（食物栏位）。"
		"食用后自动补充，永不饥饿！"
		"从地牢宝箱获得。"
	]
	quest.80CA1607D0153EBE.quest_subtitle: "永不饥饿"
	quest.80CA1607D0153EBE.title: "无尽牛肉"
	quest.815F07687ABBE20F.quest_desc: [
		"攻击模块提供伤害、暴击、攻速等心得。"
		"近战/远程流派都值得投入。"
		"Boss 战前强化攻击模块。"
	]
	quest.815F07687ABBE20F.quest_subtitle: "输出强化"
	quest.815F07687ABBE20F.title: "攻击模块"
	quest.81C4696C6D33F406.quest_desc: ["召唤冰晶守卫，发射冰刺。"]
	quest.81C4696C6D33F406.quest_subtitle: "极光宫殿"
	quest.81C4696C6D33F406.title: "冰雪女王"
	quest.839EE6A848B19C62.quest_desc: ["灵魂铁砧（Souls Anvil）是亡灵主题维度。"]
	quest.839EE6A848B19C62.quest_subtitle: "亡灵维度"
	quest.839EE6A848B19C62.title: "灵魂铁砧"
	quest.83A2BB772DA9F7F7.quest_desc: [
		"月光怀表可以查看当前的月相与时间。"
		"月相会影响某些模组的机制（如神秘学的仪式）。"
	]
	quest.83A2BB772DA9F7F7.quest_subtitle: "月相与时间"
	quest.83A2BB772DA9F7F7.title: "月光怀表"
	quest.845F08E38DA86D39.quest_desc: [
		"灾厄标志性 Boss。"
		"烈焰冲击与火球。"
		"火焰抗性必备。"
		"掉落灾厄核心材料。"
	]
	quest.845F08E38DA86D39.quest_subtitle: "灾厄烈焰"
	quest.845F08E38DA86D39.title: "焰魔"
	quest.84DC2EFCD1B237B5.quest_desc: [
		"娜迦在暮色中央的娜迦庭院。"
		"它横冲直撞，用头撞击。"
		"推荐：盾牌格挡 + 侧向走位。"
		"击败掉落娜迦鳞片。"
	]
	quest.84DC2EFCD1B237B5.quest_subtitle: "暮色第一战"
	quest.84DC2EFCD1B237B5.title: "娜迦庭院"
	quest.852AA90163605253.quest_desc: [
		"Curios 提供独立饰品栏位：护符、戒指、腰带、项链等。"
		"装备饰品获得独特效果。"
		"本包定制了大量 Curios 饰品。"
	]
	quest.852AA90163605253.quest_subtitle: "自由搭配"
	quest.852AA90163605253.title: "饰品系统"
	quest.8563DBC619DA39C1.quest_desc: [
		"顿悟是 Epiphany 的终极奖励。"
		"通常需要完成特定模块才能解锁。"
		"奖励包括永久属性、效果、物品等。"
		"例如「剑之进化」顿悟奖励进化之剑。"
	]
	quest.8563DBC619DA39C1.quest_subtitle: "觉醒之力"
	quest.8563DBC619DA39C1.title: "顿悟"
	quest.85780F0EC2AA5C95.quest_desc: [
		"Graveyard 模组的墓园结构。"
		"复活的骷髅与骨制武器。"
		"击败它们获得骨材料。"
	]
	quest.85780F0EC2AA5C95.quest_subtitle: "死者低语"
	quest.85780F0EC2AA5C95.title: "墓园探索"
	quest.85813DBAD3C681D0.quest_desc: [
		"石镐挖铁矿，熔炉烧成铁锭。"
		"Y=-59 附近是钻石层，Y=0-16 有铁。"
		"矿洞中注意：岩浆、苦力怕、岔路迷路。"
	]
	quest.85813DBAD3C681D0.quest_subtitle: "铁矿与煤"
	quest.85813DBAD3C681D0.title: "下矿"
	quest.85D6FFE855549928.quest_desc: [
		"欢迎来到 if-1.3 整合包！"
		"本包包含光谱、暮色森林、灾厄、顿悟、图鉴等大量内容，以及许多 KubeJS 定制物品。"
		"按 K 打开顿悟界面，按 Q 打开任务书，跟随指引开始冒险吧！"
	]
	quest.85D6FFE855549928.quest_subtitle: "开始你的冒险"
	quest.85D6FFE855549928.title: "欢迎来到 if-1.3"
	quest.86155CBFCF3C41C1.quest_desc: [
		"巫妖镇守巫妖塔顶层，使用魔法战斗。"
		"它会瞬移、召唤仆从并释放法术。"
		"击败后掉落巫师权杖。"
	]
	quest.86155CBFCF3C41C1.quest_subtitle: "暮色法师"
	quest.86155CBFCF3C41C1.title: "巫妖"
	quest.880DB55798EC59CC.quest_desc: [
		"幸运7 是 Curios 护符饰品。"
		"效果：每第 7 次攻击造成 77%~777% 随机伤害。"
		"装备在护符槽位。"
		"欧皇必备！"
	]
	quest.880DB55798EC59CC.quest_subtitle: "幸运的眷顾"
	quest.880DB55798EC59CC.title: "幸运7"
	quest.887EBDF2C3D98D7F.quest_desc: [
		"凋灵由灵魂沙和凋灵骷髅头召唤。"
		"生成时爆炸，攻击附带凋零效果。"
		"推荐：远程风筝打法、牛奶解凋零。"
	]
	quest.887EBDF2C3D98D7F.quest_subtitle: "下界的灾厄"
	quest.887EBDF2C3D98D7F.title: "凋灵"
	quest.88CE4EACE6BE7BA6.quest_desc: [
		"先驱者（The Harbinger）预示灾厄的降临。"
		"它从灾厄维度现身，拥有强大的远程攻击。"
	]
	quest.88CE4EACE6BE7BA6.quest_subtitle: "灾厄的使者"
	quest.88CE4EACE6BE7BA6.title: "先驱者"
	quest.890AB42FF4F2C1DA.quest_desc: [
		"击败 Boss 图鉴中的全部目标。"
		"原版 2 + 暮色 8 + 灾厄 10 + 其他。"
		"进化之剑的成长将达到巅峰！"
	]
	quest.890AB42FF4F2C1DA.quest_subtitle: "图鉴集齐"
	quest.890AB42FF4F2C1DA.title: "全 Boss 征服"
	quest.893622E90AA0F49B.quest_desc: [
		"Weather2 提供动态天气系统（风暴、龙卷风）。"
		"Ambient Sounds、Presence Footsteps 增强音效。"
		"Enhanced Celestials 改变月相与天体。"
		"沉浸感拉满。"
	]
	quest.893622E90AA0F49B.quest_subtitle: "真实世界"
	quest.893622E90AA0F49B.title: "环境与天气"
	quest.89A30FD54C7B2C1D.quest_desc: [
		"与村民交易绿宝石。"
		"More Villagers 添加新职业：矿工、猎人、木匠等。"
		"建造职业站点（如蓝图桌）解锁新交易。"
	]
	quest.89A30FD54C7B2C1D.quest_subtitle: "村庄经济"
	quest.89A30FD54C7B2C1D.title: "村民交易"
	quest.8B5239FBD1FD2B42.quest_desc: [
		"深渊（Abyssal Depths）是灾厄的第一个维度。"
		"这里海水幽暗，栖息着深海怪物。"
		"进入后先熟悉灾厄的怪物强度——它们明显更强。"
	]
	quest.8B5239FBD1FD2B42.quest_subtitle: "Cataclysm 起点"
	quest.8B5239FBD1FD2B42.title: "深渊"
	quest.8B9D96B756F177A5.quest_desc: [
		"雪怪首领住在积雪森林的洞穴。"
		"它投掷冰块、锤击地面。"
	]
	quest.8B9D96B756F177A5.quest_subtitle: "雪怪首领"
	quest.8B9D96B756F177A5.title: "雪山之巅"
	quest.8BDC5AC1D6BCB31E.quest_desc: [
		"Field Guide 图鉴记录你发现的生物。"
		"击杀/扫描新生物解锁条目。"
		"每解锁一个新图鉴获得 2 阅历！"
		"图鉴总数达到 10 时攻击伤害 +1。"
	]
	quest.8BDC5AC1D6BCB31E.quest_subtitle: "探索与收集"
	quest.8BDC5AC1D6BCB31E.title: "Field Guide 图鉴"
	quest.8EB1374A2A9E7740.quest_desc: [
		"当你装备成型后："
		"挑战灾厄全部 Boss、击败光谱怪物、集齐图鉴。"
		"进化之剑将记录你的每一次胜利！"
	]
	quest.8EB1374A2A9E7740.quest_subtitle: "检验实力"
	quest.8EB1374A2A9E7740.title: "综合挑战"
	quest.912715D51CF59109.quest_desc: [
		"烈焰粉 + 末影珍珠合成末影之眼。"
		"右键抛出，它会飞向要塞方向。"
		"跟随直到它钻入地面。"
	]
	quest.912715D51CF59109.quest_subtitle: "定位要塞"
	quest.912715D51CF59109.title: "末影之眼"
	quest.9136682575250DEF.quest_desc: [
		"开垦农田种植小麦。"
		"小麦→面包，或喂牛繁殖。"
		"注意水源湿润耕地。"
	]
	quest.9136682575250DEF.quest_subtitle: "粮食安全"
	quest.9136682575250DEF.title: "农业"
	quest.91D7745CFA3D1339.quest_desc: [
		"基岩剑是光谱后期的最强武器之一。"
		"需要大量光谱进度。"
		"配合光谱附魔与颜料效果极强。"
	]
	quest.91D7745CFA3D1339.quest_subtitle: "光谱巅峰"
	quest.91D7745CFA3D1339.title: "基岩剑"
	quest.91E8B2E376BD5466.quest_desc: [
		"幻影骑士守卫暗黑森林城堡。"
		"它们隐身突袭，成群出现。"
		"注意听脚步声与闪烁的盔甲。"
		"击败后获得幻影铠甲。"
	]
	quest.91E8B2E376BD5466.quest_subtitle: "幻影骑士"
	quest.91E8B2E376BD5466.title: "暗黑城堡"
	quest.929EC2010363124F.quest_desc: [
		"极光宫殿顶层。"
		"召唤冰晶守卫、发射冰刺。"
		"先清守卫再打本体。"
	]
	quest.929EC2010363124F.quest_subtitle: "极光宫殿"
	quest.929EC2010363124F.title: "冰雪女王"
	quest.92BE8F6688437717.quest_desc: [
		"末影人掉落末影珍珠。"
		"珍珠 = 瞬移 + 末影之眼材料。"
		"凝视末影人会被攻击！"
