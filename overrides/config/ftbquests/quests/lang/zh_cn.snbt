	quest.BDABE898736A3566.quest_desc: [
		"绿宝石是村民交易货币。"
		"挖矿获得或与村民交易。"
		"More Villagers 模组扩展了村民职业。"
	]
	quest.BDABE898736A3566.quest_subtitle: "贸易货币"
	quest.BDABE898736A3566.title: "绿宝石"
	quest.BE5924A37935B4CD.quest_desc: [
		"米诺菇在迷宫花园深处。"
		"迷宫容易迷路——带火把标记。"
		"它冲撞威力巨大。"
	]
	quest.BE5924A37935B4CD.quest_subtitle: "迷宫之主"
	quest.BE5924A37935B4CD.title: "迷宫花园"
	quest.BF2FE182CA486294.quest_desc: [
		"没有自然指南针？用普通指南针配合地图定位。"
		"探索不同生物群系收集独特资源。"
	]
	quest.BF2FE182CA486294.quest_subtitle: "定向寻物"
	quest.BF2FE182CA486294.title: "自然指南针"
	quest.BF864F9D07D9642A.quest_desc: [
		"探索模块奖励探索行为：进维度、进结构等。"
		"与维度指引章节联动。"
		"探索越多，阅历越多。"
	]
	quest.BF864F9D07D9642A.quest_subtitle: "走遍天下"
	quest.BF864F9D07D9642A.title: "探索模块"
	quest.BF9B79C7F92B3D3F.quest_desc: [
		"Transmog 允许物品外观幻化。"
		"在幻化台上把装备外观换成其他物品。"
		"好看与强大兼得！"
	]
	quest.BF9B79C7F92B3D3F.quest_subtitle: "外观自由"
	quest.BF9B79C7F92B3D3F.title: "幻化系统 Transmog"
	quest.BFB36D9406E7C5CA.quest_desc: [
		"月光怀表显示当前月相与时间。"
		"月相影响部分模组机制。"
		"探索与仪式前看一眼。"
	]
	quest.BFB36D9406E7C5CA.quest_subtitle: "月相观测"
	quest.BFB36D9406E7C5CA.title: "月光怀表"
	quest.BFE3FA6BAD17408D.quest_desc: [
		"紫颂植物生长在末地岛。"
		"食用随机传送（可能摔死！）。"
		"烤紫颂果是食物来源。"
	]
	quest.BFE3FA6BAD17408D.quest_subtitle: "末地特产"
	quest.BFE3FA6BAD17408D.title: "紫颂果"
	quest.C54898F425D8D9F2.quest_desc: [
		"铁木树遍布暮色，砍伐得铁木。"
		"铁木锭合成铁木工具/装备。"
		"暮色装备是中期重要战力。"
	]
	quest.C54898F425D8D9F2.quest_subtitle: "暮色基础材料"
	quest.C54898F425D8D9F2.title: "铁木"
	quest.C580C6DDCC6D2BC6.quest_desc: [
		"用灾厄材料合成灾厄装备（Ignitium 系列）。"
		"灾厄装备拥有强大的属性，是后期核心战力。"
	]
	quest.C580C6DDCC6D2BC6.quest_subtitle: "变强的阶梯"
	quest.C580C6DDCC6D2BC6.title: "灾厄装备"
	quest.C59C0996DAEEE6F5.quest_desc: [
		"打造全套铁装 + 铁剑 + 铁镐。"
		"铁装让你能深入矿洞与下界。"
		"接下来去探索世界吧！"
	]
	quest.C59C0996DAEEE6F5.quest_subtitle: "中期起点"
	quest.C59C0996DAEEE6F5.title: "铁装毕业"
	quest.C5BB0713ACCD1881.quest_desc: [
		"Epiphany 是本包的成长系统："
		"完成模块获得心得点与顿悟槽位。"
		"点亮心得获得永久加成，激活顿悟获得强大能力。"
		"按 K 键打开顿悟界面！"
	]
	quest.C5BB0713ACCD1881.quest_subtitle: "成长的核心"
	quest.C5BB0713ACCD1881.title: "顿悟系统（Epiphany）"
	quest.C5E3A6003C1CE62E.quest_desc: [
		"Nether Depth Upgrade 为下界添加了独特鱼类。"
		"用熔岩钓鱼竿在熔岩中垂钓！"
	]
	quest.C5E3A6003C1CE62E.quest_subtitle: "熔岩之鱼"
	quest.C5E3A6003C1CE62E.title: "下界深潜"
	quest.C722854B7B43A77D.quest_desc: [
		"九头蛇镇守火焰沼泽的九头蛇巢穴，有多个头。"
		"喷火攻击范围大，斩掉的头会再生。"
		"推荐：远程输出 + 走位躲避火焰。"
	]
	quest.C722854B7B43A77D.quest_subtitle: "火之巨兽"
	quest.C722854B7B43A77D.title: "九头蛇"
	quest.C87A171AC826A6FC.quest_desc: [
		"用手或工具破坏原木。"
		"第一件事：收集至少 20 个原木。"
		"原木可以合成木板、木棍，是一切合成的起点。"
	]
	quest.C87A171AC826A6FC.quest_subtitle: "第一根原木"
	quest.C87A171AC826A6FC.title: "砍树"
	quest.C8B45A8415D6AC00.quest_desc: [
		"3 凋灵骷髅头 + 4 灵魂沙召唤凋灵。"
		"生成时大爆炸，攻击附凋零。"
		"推荐：地下/基岩层打（防飞走）、远程输出、牛奶解凋零。"
		"掉落下界之星（信标核心）。"
	]
	quest.C8B45A8415D6AC00.quest_subtitle: "下界的灾厄"
	quest.C8B45A8415D6AC00.title: "凋灵"
	quest.C939B774F4EBDF67.quest_desc: [
		"末影龙盘踞末地中央龙岛。"
		"攻击策略：摧毁水晶→远程射龙。"
		"推荐：附魔弓、金苹果、落地缓冲。"
		"击败后龙岛中心出现返回传送门。"
	]
	quest.C939B774F4EBDF67.quest_subtitle: "终焉之王"
	quest.C939B774F4EBDF67.title: "末影龙"
	quest.C9787A40B7127372.quest_desc: [
		"制作地图记录地形，Xaero 小地图会常驻显示。"
		"M 打开大地图，寻找感兴趣的生物群系。"
	]
	quest.C9787A40B7127372.quest_subtitle: "不迷路"
	quest.C9787A40B7127372.title: "制图与探索"
	quest.CA0FA5F6B8A88062.quest_desc: [
		"青金石用于附魔（附魔台消耗）。"
		"挖到就存着，附魔装备必备。"
	]
	quest.CA0FA5F6B8A88062.quest_subtitle: "附魔之源"
	quest.CA0FA5F6B8A88062.title: "青金石"
	quest.CAC42B13D72ACA08.quest_desc: [
		"收集 12 颗钻石。"
		"挖一个 2×2 的水池。"
		"把钻石扔进水池——水面会变成传送门！"
		"暮色森林是中期最重要的维度之一。"
	]
	quest.CAC42B13D72ACA08.quest_subtitle: "童话之门"
	quest.CAC42B13D72ACA08.title: "开启暮色传送门"
	quest.CB721D9DF9013F10.quest_desc: [
		"设计仓库时考虑："
		"常用物品快速取用、自动分类、批量烧炼。"
		"RS + 漏斗 + 红石组合。"
		"干净高效的仓库让游戏更愉快。"
	]
	quest.CB721D9DF9013F10.quest_subtitle: "仓库设计"
	quest.CB721D9DF9013F10.title: "物流规划"
	quest.CBBB7E313AA182B8.quest_desc: [
		"灾厄海洋区域的海怪。"
		"攻击范围惊人。"
	]
	quest.CBBB7E313AA182B8.quest_subtitle: "深海巨兽"
	quest.CBBB7E313AA182B8.title: "利维坦"
	quest.CC3732855F6C0843.quest_desc: [
		"Boss 与稀有生物同样在图鉴中。"
		"击杀 Boss 解锁稀有条目（+2 阅历）。"
		"图鉴与 Boss 图鉴章节联动。"
	]
	quest.CC3732855F6C0843.quest_subtitle: "图鉴大师"
	quest.CC3732855F6C0843.title: "稀有生物"
	quest.CCF66ECDE48B8CCC.quest_desc: [
		"Boss 战前检查："
		"① 附魔装备（保护/锋利/力量）"
		"② 充足的食物与治疗药水"
		"③ 进化之剑加成到位"
		"④ 了解 Boss 的攻击模式"
	]
	quest.CCF66ECDE48B8CCC.quest_subtitle: "战前清单"
	quest.CCF66ECDE48B8CCC.title: "Boss 战准备"
	quest.CF0A974C5636ABBF.quest_desc: [
		"末影龙盘踞在末地中央的龙岛上。"
		"击杀它会掉落大量经验并开启末地城。"
		"推荐：附魔弓+箭、金苹果、落地防护。"
	]
	quest.CF0A974C5636ABBF.quest_subtitle: "终焉之王"
	quest.CF0A974C5636ABBF.title: "末影龙"
	quest.CF92947BBFD30E04.quest_desc: [
		"挖掘紫水晶簇获得水晶粉。"
		"水晶粉是所有光谱合成的基础。"
		"紫水晶母岩可反复收获。"
	]
	quest.CF92947BBFD30E04.quest_subtitle: "光谱基石"
	quest.CF92947BBFD30E04.title: "水晶粉"
	quest.D0BAB9D0E20010D8.quest_desc: [
		"利维坦（The Leviathan）是灾厄的海怪 Boss。"
		"巨大的身体横扫战场。"
		"注意它的冲锋与甩尾。"
	]
	quest.D0BAB9D0E20010D8.quest_subtitle: "深海巨兽"
	quest.D0BAB9D0E20010D8.title: "利维坦"
	quest.D18DB316B929AA79.quest_desc: [
		"在末地船中找到鞘翅。"
		"配合烟花火箭即可飞行。"
		"探索更远的末地岛屿！"
	]
	quest.D18DB316B929AA79.quest_subtitle: "翱翔天际"
	quest.D18DB316B929AA79.title: "鞘翅飞行"
	quest.D22946A9A0455BF8.quest_desc: [
		"下界 Y=8-22 的岩层中埋藏着远古残骸。"
		"4 残骸 + 4 金锭合成下界合金碎片。"
	]
	quest.D22946A9A0455BF8.quest_subtitle: "下界合金"
	quest.D22946A9A0455BF8.title: "远古残骸"
	quest.D2698C92D3386F3B.quest_desc: [
		"目光攻击。"
		"注意朝向走位。"
	]
	quest.D2698C92D3386F3B.quest_subtitle: "注视一切"
	quest.D2698C92D3386F3B.title: "观测者"
	quest.D2D6BADB723EEA35.quest_desc: [
		"用 12 颗钻石开启暮色传送门。"
		"按顺序挑战暮色 Boss：娜迦→巫妖→九头蛇→…"
		"暮色装备是中期的重要战力。"
	]
	quest.D2D6BADB723EEA35.quest_subtitle: "童话冒险"
	quest.D2D6BADB723EEA35.title: "暮色路线"
	quest.D2E9B3FF0A867939.quest_desc: [
		"熔炉用于冶炼矿物和烹饪食物。"
		"用 8 个圆石合成一个熔炉。"
	]
	quest.D2E9B3FF0A867939.quest_subtitle: "冶炼与烹饪"
	quest.D2E9B3FF0A867939.title: "制作熔炉"
	quest.D37DC2C9A7A5236B.quest_desc: [
		"蓝图桌是 More Villagers 的职业站点。"
		"放置后村民可转职为建筑师。"
		"交易获得建筑图纸。"
	]
	quest.D37DC2C9A7A5236B.quest_subtitle: "新职业"
	quest.D37DC2C9A7A5236B.title: "工匠蓝图桌"
	quest.D3B87449D2538927.quest_desc: [
		"羊驼披风提供额外防护。"
		"从各地遗迹宝箱获得。"
	]
	quest.D3B87449D2538927.quest_subtitle: "护体神器"
	quest.D3B87449D2538927.title: "羊驼披风"
	quest.D49A6FA5CA9F7AC8.quest_desc: [
		"钢叶草长在钢叶树林。"
		"钢叶锭比铁木更强。"
		"进一步强化暮色装备。"
	]
	quest.D49A6FA5CA9F7AC8.quest_subtitle: "更高级的材料"
	quest.D49A6FA5CA9F7AC8.title: "钢叶"
	quest.D51DABFFD083575F.quest_desc: ["暗黑森林城堡，隐身突袭。"]
	quest.D51DABFFD083575F.quest_subtitle: "城堡之影"
	quest.D51DABFFD083575F.title: "幻影骑士"
	quest.D58E72E310275DFF.quest_desc: [
		"木棍 + 煤炭/木炭合成火把。"
		"矿洞与夜晚都需要照明，防止怪物生成。"
		"4 个火把是最低配置。"
	]
	quest.D58E72E310275DFF.quest_subtitle: "照亮黑暗"
	quest.D58E72E310275DFF.title: "火把"
	quest.D68A5AA6BD281F42.quest_desc: [
		"焰魔（Ignis）是灾厄模组的强大 Boss。"
		"击败它可获得灾厄核心材料，用于高级合成。"
		"建议使用进化之剑并做好充分准备！"
	]
	quest.D68A5AA6BD281F42.quest_subtitle: "灾厄 Boss"
	quest.D68A5AA6BD281F42.title: "焰魔试炼"
	quest.D6A502F1FAF95099.quest_desc: [
		"本包还有独特模块："
		"牺牲（Sacrifice）：以自身代价换取力量。"
		"研习（Study）：阅历倍率、经验、进食速度等。"
		"顿悟（Infinity）：全局阅历配置。"
		"总有一款适合你！"
	]
	quest.D6A502F1FAF95099.quest_subtitle: "玩法多样"
	quest.D6A502F1FAF95099.title: "特殊模块"
	quest.D72E7B724DDB2B6A.quest_desc: [
		"光谱用颜料与画笔施展颜色魔法。"
		"合成画笔，开始你的光谱创作。"
	]
	quest.D72E7B724DDB2B6A.quest_subtitle: "颜色的魔法"
	quest.D72E7B724DDB2B6A.title: "颜料与画笔"
	quest.D7857CC3B8E7C8CC.quest_desc: [
		"光谱使用颜料与画笔施展颜色魔法。"
		"合成画笔与颜料。"
		"颜色是光谱的核心概念之一。"
	]
	quest.D7857CC3B8E7C8CC.quest_subtitle: "颜色魔法"
	quest.D7857CC3B8E7C8CC.title: "颜料与画笔"
	quest.D791594464568FC5.quest_desc: [
		"灵魂铁砧（Souls Anvil）是亡灵主题维度。"
		"亡灵军团漫游的荒原。"
		"收集灵魂精华用于合成。"
	]
	quest.D791594464568FC5.quest_subtitle: "亡灵维度"
	quest.D791594464568FC5.title: "灵魂铁砧"
	quest.D7E805DA846A32C3.quest_desc: [
		"欢迎来到 if-1.3 整合包！"
		"本包以光谱（Spectrum）、暮色森林（Twilight Forest）、灾厄（L_Ender's Cataclysm）三大内容模组为核心，配合顿悟（Epiphany）成长系统、Field Guide 图鉴、KubeJS 定制物品等特色玩法。"
		"按 K 打开顿悟界面，按 Q 打开任务书，按 E 打开物品栏（EMI 配方查询）。"
		"本任务书将引导你从零开始，逐步征服这个世界。"
	]
	quest.D7E805DA846A32C3.quest_subtitle: "开始你的冒险"
	quest.D7E805DA846A32C3.title: "欢迎来到 if-1.3"
	quest.D810A485ED03241B.quest_desc: [
		"皮革来自牛/马/兔。"
		"做一套皮革甲过渡。"
		"之后尽快升级铁甲。"
	]
	quest.D810A485ED03241B.quest_subtitle: "基础防护"
	quest.D810A485ED03241B.title: "皮革护甲"
	quest.D85618F82AF29F9C.quest_desc: [
		"卡片从各种途径获得："
		"击杀生物、探索地牢、交易、任务奖励等。"
		"多探索多收集！"
	]
	quest.D85618F82AF29F9C.quest_subtitle: "探索收集"
	quest.D85618F82AF29F9C.title: "获取卡片"
	quest.D8722C2EF60FDCB1.quest_desc: [
		"灾厄标志性 Boss，浑身烈焰。"
		"掉落灾厄核心材料。"
	]
	quest.D8722C2EF60FDCB1.quest_subtitle: "灾厄烈焰"
	quest.D8722C2EF60FDCB1.title: "焰魔"
	quest.D8B4DD5FA687D1A6.quest_desc: ["地狱之口（Inferno's Maw）是烈焰主题维度。"]
	quest.D8B4DD5FA687D1A6.quest_subtitle: "烈焰维度"
	quest.D8B4DD5FA687D1A6.title: "地狱之口"
	quest.D9815DF1BCADD49C.quest_desc: [
		"潜影贝掉落壳（末地城）。"
		"2 壳 + 箱子 = 潜影盒。"
		"潜影盒可携带大量物品，随身仓库！"
	]
	quest.D9815DF1BCADD49C.quest_subtitle: "便携箱子"
	quest.D9815DF1BCADD49C.title: "潜影贝壳"
	quest.DAE719AC7A0A253A.quest_desc: [
		"漏斗自动传输物品。"
		"漏斗链 + 箱子实现简单分类。"
		"进阶用 Refined Storage。"
	]
	quest.DAE719AC7A0A253A.quest_subtitle: "自动化起点"
	quest.DAE719AC7A0A253A.title: "漏斗物流"
	quest.DB49B4AA10026CE3.quest_desc: [
		"完成所有 Epiphany 模块。"
		"点亮全部心得，激活全部顿悟。"
		"你是真正的顿悟大师！"
	]
	quest.DB49B4AA10026CE3.quest_subtitle: "知识巅峰"
	quest.DB49B4AA10026CE3.title: "顿悟全通"
	quest.DDDD7D5F36454E2F.quest_desc: [
		"部分神器可以升级强化。"
		"配合 Curios 槽位组合使用。"
		"神器是后期战力的重要补充。"
	]
	quest.DDDD7D5F36454E2F.quest_subtitle: "更强大"
	quest.DDDD7D5F36454E2F.title: "神器强化"
	quest.DE73CD5AC0B6F474.quest_desc: [
		"暮色第一位 Boss，娜迦庭院。"
		"横冲直撞，头击攻击。"
		"推荐：盾牌格挡 + 侧向走位。"
		"掉落娜迦鳞片。"
	]
	quest.DE73CD5AC0B6F474.quest_subtitle: "暮色蛇王"
	quest.DE73CD5AC0B6F474.title: "娜迦"
	quest.DE7C55DC06EDC066.quest_desc: [
		"巫妖塔在暗黑森林，是座高塔。"
		"巫妖会瞬移、召唤仆从、释放法术。"
		"击败后获得巫师权杖。"
	]
	quest.DE7C55DC06EDC066.quest_subtitle: "魔法对决"
	quest.DE7C55DC06EDC066.title: "巫妖塔"
	quest.DF2163C96DE52B50.quest_desc: [
		"下界合金巨兽（Netherite Monstrosity）全身下界合金。"
		"防御极高，正面硬拼吃亏。"
		"寻找弱点或持续消耗。"
	]
	quest.DF2163C96DE52B50.quest_subtitle: "金属怪物"
	quest.DF2163C96DE52B50.title: "下界合金巨兽"
	quest.E0A5FD34FDC2A625.quest_desc: [
		"积雪森林洞穴。"
		"投掷冰块、锤击地面。"
		"狭窄空间注意躲避。"
	]
	quest.E0A5FD34FDC2A625.quest_subtitle: "雪山王者"
	quest.E0A5FD34FDC2A625.title: "雪怪首领"
	quest.E10460053EF8A566.quest_desc: [
		"末影傀儡（Ender Golem）是灾厄中的末影系 Boss。"
		"它能够瞬移并造成范围伤害。"
	]
	quest.E10460053EF8A566.quest_subtitle: "末影的造物"
	quest.E10460053EF8A566.title: "末影傀儡"
	quest.E1CF783788172148.quest_desc: [
		"永恒之星是本包的重要合成材料。"
		"通过难度调节器或其他途径获取，用于高级合成。"
	]
	quest.E1CF783788172148.quest_subtitle: "稀有材料"
	quest.E1CF783788172148.title: "永恒之星"
	quest.E32684B27B95E909.quest_desc: [
		"打草丛获得小麦种子，开垦农田。"
		"也可以钓鱼或猎杀动物。"
		"饥饿度归零会掉血，保持饱食！"
	]
	quest.E32684B27B95E909.quest_subtitle: "别饿肚子"
	quest.E32684B27B95E909.title: "食物"
	quest.E44E6257822598F9.quest_desc: [
		"斯库拉（Scylla）是灾厄的海妖 Boss。"
		"在水域中高速穿梭。"
		"水上战斗注意立足点。"
	]
	quest.E44E6257822598F9.quest_subtitle: "海妖传说"
	quest.E44E6257822598F9.title: "斯库拉"
	quest.E598F2F4A0E545E1.quest_desc: ["积雪森林洞穴，投掷冰块、锤击地面。"]
	quest.E598F2F4A0E545E1.quest_subtitle: "雪山王者"
	quest.E598F2F4A0E545E1.title: "雪怪首领"
	quest.E5DE59D4C45610AC.quest_desc: [
		"终极装备组合："
		"下界合金基础 → 暮色/灾厄/光谱进阶 → 神器饰品。"
		"全套附魔 + 锻造模板升级。"
		"Curios 饰品栏自由搭配。"
	]
	quest.E5DE59D4C45610AC.quest_subtitle: "武装到牙齿"
	quest.E5DE59D4C45610AC.title: "最强装备"
	quest.E5E2AB29955B7364.quest_desc: [
		"恶魂掉落恶魂之泪。"
		"用于再生药水等高级酿造。"
		"恶魂的火球可以打回去！"
	]
	quest.E5E2AB29955B7364.quest_subtitle: "稀有掉落"
	quest.E5E2AB29955B7364.title: "恶魂之泪"
	quest.E6685B6D38EDBB40.quest_desc: [
		"按 K 打开顿悟界面。"
		"顿悟（Epiphany）是本包的成长系统："
		"模块（Module）→ 心得（Insight）→ 顿悟（Epiphany）。"
		"完成模块获得心得点；点亮心得获得永久加成；激活顿悟获得强大能力。"
	]
	quest.E6685B6D38EDBB40.quest_subtitle: "成长核心"
	quest.E6685B6D38EDBB40.title: "顿悟系统"
	quest.E916CA91C663E544.quest_desc: [
		"黄昏之钟是一件神秘物品。"
		"它象征黄昏时刻的力量。"
		"更多用途等待你的探索。"
		"与其他 KubeJS 物品一样，它是本包独有的内容。"
	]
	quest.E916CA91C663E544.quest_subtitle: "黄昏的见证"
	quest.E916CA91C663E544.title: "黄昏之钟"
	quest.E9583683C22EB2F4.quest_desc: [
		"打造你的终极装备组合："
		"下界合金基础 + 灾厄/暮色/光谱进阶 + 神器饰品。"
		"搭配 Curios 饰品栏自由组合。"
	]
	quest.E9583683C22EB2F4.quest_subtitle: "武装到牙齿"
	quest.E9583683C22EB2F4.title: "最强装备"
	quest.E9B65D4AF20FF2B3.quest_desc: [
		"挖矿获取铁与钻石，打造基础装备。"
		"寻找暮色传送门材料（12 颗钻石）。"
		"收集经验，为 Boss 战做准备。"
	]
	quest.E9B65D4AF20FF2B3.quest_subtitle: "装备与资源"
	quest.E9B65D4AF20FF2B3.title: "中期发展"
	quest.EAC2126C6C8DACB1.quest_desc: [
		"地狱之口（Inferno's Maw）是烈焰主题维度。"
		"炽热的走廊与火元素生物。"
		"火焰抗性药水是必需品。"
	]
	quest.EAC2126C6C8DACB1.quest_subtitle: "烈焰维度"
	quest.EAC2126C6C8DACB1.title: "地狱之口"
	quest.EAFAF2B85B417408.quest_desc: [
		"焰魔（Ignis）是灾厄的标志性 Boss。"
		"击败它获得灾厄核心材料。"
		"更多 Boss 详见「Boss 图鉴」章节。"
	]
	quest.EAFAF2B85B417408.quest_subtitle: "灾厄的标志"
	quest.EAFAF2B85B417408.title: "焰魔试炼"
	quest.EB4793C119CB7487.quest_desc: [
		"光谱（Spectrum）是深度魔法系统。"
		"先获得光谱指南书——它逐步指导你。"
		"光谱有独立的进度线（任务书中原有光谱章节）。"
		"核心资源：各种水晶粉与水晶碎片。"
	]
	quest.EB4793C119CB7487.quest_subtitle: "魔法的开始"
	quest.EB4793C119CB7487.title: "光谱指南"
	quest.EB48631D076231E1.quest_desc: [
		"末地船中悬挂的鞘翅。"
		"装备在胸甲栏。"
		"配合烟花火箭飞行。"
		"鞘翅是后期探索的核心！"
	]
	quest.EB48631D076231E1.quest_subtitle: "翱翔天际"
	quest.EB48631D076231E1.title: "鞘翅"
	quest.ECABBBF7EABF091B.quest_desc: [
		"还有更多 Boss 等你挑战："
		"mowziesmobs：钢铁守护者、霜冻巨兽、雕刻家、太阳鸟。"
		"dungeonnowloading：公正衔环·波罗斯与乌洛斯。"
		"spectrum：怪物（Monstrosity）。"
		"全部击败——进化之剑将记录一切！"
	]
	quest.ECABBBF7EABF091B.quest_subtitle: "挑战不止"
	quest.ECABBBF7EABF091B.title: "更多 Boss"
	quest.ECD3ADA8B4F2222D.quest_desc: [
		"钓鱼获得鱼、宝藏、附魔书。"
		"夜晚钓鱼更安静。"
		"钓鱼竿也是很多模组配方。"
	]
	quest.ECD3ADA8B4F2222D.quest_subtitle: "耐心与收获"
	quest.ECD3ADA8B4F2222D.title: "钓鱼"
	quest.ECDBE596D03C54EF.quest_desc: [
		"雪怪首领栖息在积雪森林的雪怪洞穴。"
		"它投掷冰块并猛烈锤击地面。"
		"击败后掉落雪怪皮毛。"
	]
	quest.ECDBE596D03C54EF.quest_subtitle: "雪山的王者"
	quest.ECDBE596D03C54EF.title: "雪怪首领"
	quest.ED227718A931E2DA.quest_desc: [
		"暮色最终 Boss，漂浮暗黑高塔之上。"
		"召唤火球与爪牙。"
	]
	quest.ED227718A931E2DA.quest_subtitle: "高塔之巅"
	quest.ED227718A931E2DA.title: "暮初恶魂"
	quest.ED269A28FECA1CE2.quest_desc: ["掌握远古之力，攻击多样。"]
	quest.ED269A28FECA1CE2.quest_subtitle: "古老存在"
	quest.ED269A28FECA1CE2.title: "远古遗魂"
	quest.ED3A266A79C1C11A.quest_desc: [
		"与村民交易获取绿宝石。"
		"寻找 morevillagers 的职业站点解锁更多交易。"
	]
	quest.ED3A266A79C1C11A.quest_subtitle: "贸易往来"
	quest.ED3A266A79C1C11A.title: "村庄经济"
	quest.EDB9591A59DB2DBC.quest_desc: [
		"用黑曜石搭 4×5 门框，打火石点燃。"
		"下界有石英、远古残骸等珍贵资源。"
	]
	quest.EDB9591A59DB2DBC.quest_subtitle: "烈焰之地"
	quest.EDB9591A59DB2DBC.title: "开启下界之门"
	quest.EFF99EFCFE38687F.quest_desc: [
		"每第 7 次攻击 77%~777% 随机伤害。"
		"护符槽位。"
		"欧皇必备饰品。"
	]
	quest.EFF99EFCFE38687F.quest_subtitle: "幸运护符"
	quest.EFF99EFCFE38687F.title: "幸运7"
	quest.F12FD9B79022240E.quest_desc: [
		"基岩护甲提供顶级防护。"
		"全套基岩装备 + 附魔 = 最强防御之一。"
		"与灾厄装备并列为后期双雄。"
	]
	quest.F12FD9B79022240E.quest_subtitle: "光谱防护"
	quest.F12FD9B79022240E.title: "基岩装备"
	quest.F140844712855577.quest_desc: [
		"本整合包使用 KubeJS 添加了大量定制物品与机制。"
		"包括进化之剑、幸运7、预知眼、哔哔机等，详见「装备与饰品」章节。"
		"这些物品均有独特玩法，值得深入探索。"
	]
	quest.F140844712855577.quest_subtitle: "本包的特色"
	quest.F140844712855577.title: "KubeJS 定制物品"
	quest.F1E58684A519DBD5.quest_desc: [
		"巫妖塔顶层。"
		"瞬移、召唤仆从、魔法弹幕。"
		"注意分辨真假巫妖（持权杖者）。"
		"掉落巫师权杖。"
	]
	quest.F1E58684A519DBD5.quest_subtitle: "暮色法师"
	quest.F1E58684A519DBD5.title: "巫妖"
	quest.F37CB990C801F97B.quest_desc: [
		"指南针指向世界原点。"
		"Xaero 小地图常驻显示，M 开大地图。"
		"探险前标记好回家路。"
	]
	quest.F37CB990C801F97B.quest_subtitle: "不迷路"
	quest.F37CB990C801F97B.title: "指南针与地图"
	quest.F46CFDFDEF520791.quest_desc: [
		"九头蛇在火焰沼泽的巢穴。"
		"多头喷火，斩首再生。"
		"推荐远程风筝输出。"
		"掉落九头蛇鳞片等。"
	]
	quest.F46CFDFDEF520791.quest_subtitle: "九头蛇"
	quest.F46CFDFDEF520791.title: "火焰沼泽"
	quest.F56FF33A915720E5.quest_desc: [
		"整合包用 KubeJS 制作了大量定制物品："
		"进化之剑（Boss 成长）、幸运7（随机暴击）、预知眼（闪避）、哔哔机（任务提示）等。"
		"详见「装备与饰品」章节。"
	]
	quest.F56FF33A915720E5.quest_subtitle: "本包的特色"
	quest.F56FF33A915720E5.title: "KubeJS 定制物品"
	quest.F58950C56BB5C96D.quest_desc: [
		"红石电路实现逻辑与自动化。"
		"本包有红石相关辅助。"
		"从简单的活塞门开始。"
	]
	quest.F58950C56BB5C96D.quest_subtitle: "机关与逻辑"
	quest.F58950C56BB5C96D.title: "红石工程"
	quest.F6DEE1E450D3C17B.quest_desc: [
		"近战投射兼备。"
		"格挡闪避结合。"
	]
	quest.F6DEE1E450D3C17B.quest_subtitle: "末影守护"
	quest.F6DEE1E450D3C17B.title: "末影守卫"
	quest.F6E780D8A1C55C01.quest_desc: [
		"恭喜完成新手教程！"
		"接下来探索各个维度，收集装备与饰品。"
		"记住：Boss 战前做好准备，利用进化之剑的成长机制！"
	]
	quest.F6E780D8A1C55C01.quest_subtitle: "准备迎接挑战"
	quest.F6E780D8A1C55C01.title: "新手毕业"
	quest.F73BB387D080589A.quest_desc: [
		"沼泽有女巫小屋、史莱姆（夜晚）。"
		"本包还有更多群系模组（Mystic's Biomes 等）。"
		"每个群系都有独特资源。"
	]
	quest.F73BB387D080589A.quest_subtitle: "独特生态"
	quest.F73BB387D080589A.title: "湿地与沼泽"
	quest.F78DF0CAC5E40C02.quest_desc: [
		"铁矿分布广，Y=0-16 最多。"
		"铁用于工具、护甲、桶、漏斗等。"
		"本整合包前期需要大量铁。"
	]
	quest.F78DF0CAC5E40C02.quest_subtitle: "铁制装备的基础"
	quest.F78DF0CAC5E40C02.title: "铁矿"
	quest.FBDAA35ADF9C1E2A.quest_desc: [
		"用小麦繁殖牛。"
		"熟牛排是前期最高效的食物之一。"
		"养 4-5 头牛可持续供应。"
	]
	quest.FBDAA35ADF9C1E2A.quest_subtitle: "肉食供应"
	quest.FBDAA35ADF9C1E2A.title: "畜牧业"
	quest.FE09B25DF26D7A44.quest_desc: [
		"防御/生存模块提供生命、护甲、减伤心得。"
		"高难度下生存优先。"
		"配合预知眼等饰品。"
	]
	quest.FE09B25DF26D7A44.quest_subtitle: "站得住"
	quest.FE09B25DF26D7A44.title: "防御与生存"
