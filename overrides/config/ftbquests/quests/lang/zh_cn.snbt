	quest.9700E54746450CAC.quest_subtitle: "写意的力量"
	quest.9700E54746450CAC.title: "墨水瓶"
	quest.9796E026F977A580.quest_desc: [
		"Servantry 仆从系统的饰品。"
		"招募仆从后佩戴。"
		"仆从与你并肩作战。"
	]
	quest.9796E026F977A580.quest_subtitle: "并肩作战"
	quest.9796E026F977A580.title: "仆从围巾"
	quest.97C9C3593B2C2F54.quest_desc: [
